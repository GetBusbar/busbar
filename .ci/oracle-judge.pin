# THE ORACLE JUDGE, AS PROTECTED CONFIG: a ModernCI tool pin (backend `tools:` entry
# busbar-oracle-judge, key .ci/oracle-judge.pin). The ModernCI daemon downloads it OUTSIDE any run,
# with its forge credential (the release is private), checks the sha256 for the backend's arch,
# and gives checks only the path, in $BUSBAR_ORACLE_JUDGE_PATH. No check ever holds the token.
# These are busbar-release dev-bin's assets for BUSBAR_ORACLE_RELEASE_REF
# 0fb503621c3cfac453359451c2eccdbd2ee4e8eb (asset ids: GitHub serves a private asset only from the
# API URL, as octet-stream). Each sha256 equals BUSBAR_ORACLE_SHA256_LINUX_<arch> in .ci/*.yaml,
# verified against the downloaded assets 2026-10-24 (judge fix busbar-release #424). Not a branch file (not .yaml).
url:
  x86_64: https://api.github.com/repos/GetBusbar/busbar-release/releases/assets/672722634
  aarch64: https://api.github.com/repos/GetBusbar/busbar-release/releases/assets/672722639
sha256:
  x86_64: 10074791d0557e34b033163479799b3ffb193c3acd2b9e7ef78f4941e1d29e75
  aarch64: bbf1c6c5c62add4e097b1695e939aa5502a95780870bdd1b53b237e0bf3a2834
path: busbar-oracle
auth: forge
accept: application/octet-stream
