# THE ENGINE'S ENVIRONMENT — ONE FILE, COPIED TO ~/.busbar-engine/env (F1)
# ──────────────────────────────────────────────────────────────────────────────────────────────────
# Until today the runner was restarted by hand with a fifteen-variable command line re-typed out of
# the ledger at every adoption, and every re-typing was a chance to drop a knob (measured: a
# BUSBAR_PROVE_PER_BOX=2 that outlived the box size it was measured for, and a LANDQ_PREPROVE_LINES
# left at 6 while the sweep had eighteen boxes). The restart line is now THIS FILE, and the one
# command is `bash scripts/landq-supervisor.sh`.
#
#   cp scripts/landq.env.example ~/.busbar-engine/env    # then edit the values below
#
# GRAMMAR: `NAME=value`, one per line, blank lines and `#` comments ignored. Nothing else — no
# command substitution, no pipelines, no `export` (the supervisor exports every name it reads).
# A VALUE WITH A SPACE IN IT MUST BE QUOTED (`NAME="a b"`): the file is sourced, so an unquoted
# space is a second word, and a second word is a command nobody meant to run.
# The supervisor refuses to start on a line that is not an assignment rather than sourcing it.
# `$HOME` and `$PATH` expand; they are read by the shell that starts the runner.
#
# WHAT IS *NOT* HERE: LAND_SH_SRC. The engine's own location is not an operator's choice any more —
# the supervisor sets it to ~/.busbar-engine/current/scripts, which is a `git archive` of the
# landed tip's scripts/ at the sha in ~/.busbar-engine/sha. Adoption is a landing (see
# docs/ci/landing-engine.md); a hand-staged copy under land-fanout-<sha> is not the engine.

# ── the tree the runner lands into ────────────────────────────────────────────────────────────────
LANDQ_ROOT=$HOME/Developer/GetBusbar/busbar/.claude/worktrees/config-seam-work
# ── scratch: never /tmp, never TMPDIR (owner rule, 2026-09-11) ────────────────────────────────────
LAND_TMP=$HOME/Developer/tmp
PATH=$HOME/.local/bin:$PATH
AWS_REGION=us-east-1

# ── the batch ─────────────────────────────────────────────────────────────────────────────────────
LAND_BATCH=8
LAND_CHAIN_DEPTH=8
LAND_SELFTEST_SHARDS=1
LAND_REMOTE=auto
XTASK_GATE_CEILING_SECS=3600

# ── the pre-prove sweep (never wider than the fleet's proof slots) ────────────────────────────────
LANDQ_PREPROVE_LINES=12
LANDQ_PREPROVE_HEAD=2
BUSBAR_PROVE_SEED=copy

# ── the fleet, FLEET-2's stop/start posture (an idle box is STOPPED, not paid for) ────────────────
# PER_BOX is a MEASUREMENT, not a preference: one proof per 32 vCPU (c7a.16xlarge = 2).
BUSBAR_PROVE_PER_BOX=2
LANDQ_IDLE_STOP_MINS=15
CI_RUNNER_ITYPE=c7a.16xlarge
CI_RUNNER_ONDEMAND_FLOOR=10
CI_RUNNER_RUNNING_MIN=2
CI_RUNNER_RUNNING_MAX=10

# ── the two HALTs (see the exit-code contract in docs/ci/landing-engine.md) ───────────────────────
# How many tree-moved refusals in a row are a fact about the tree rather than a stray process.
LANDQ_TREE_MOVED_HALT_AFTER=5

# ── WHICH MACHINE PROVES, AND WHICH MACHINE LANDS ─────────────────────────────────────────────────
# TWO VARIABLES, ON PURPOSE, AND THEY MOVE INDEPENDENTLY. A pre-proof that is wrong costs the queue
# an order; a landing that is wrong PUBLISHES. So the sweep's pre-proofs left the fleet first and
# the landing followed, and an operator who finds either backend wanting sets one name and restarts
# at a boundary without giving up the other. `fleet` is the historical value of both.
#
#   BUSBAR_PROVE_BACKEND=fleet|latchkey    the sweep's pre-proof leg (phase 2)
#   BUSBAR_LAND_BACKEND=fleet|latchkey     the landing's own proof (phase 3)
#
# NEITHER IS ADOPTED WITHOUT ITS GATE PASSING FIRST on the exact engine the home carries — see
# docs/ci/landing-engine.md §9:
#   landq4.sh --smoke-latchkey '<queue line>' …     the pre-proof backend
#   landq4.sh --smoke-latchkey --landing            the landing backend (one REAL landing)
#   landq4.sh --smoke-bigbatch <queue file>         the popper
BUSBAR_PROVE_BACKEND=latchkey
BUSBAR_LAND_BACKEND=fleet

# ── THE RENTED RUNNERS ────────────────────────────────────────────────────────────────────────────
# TWELVE JOBS, NOT TWENTY. The workspace's concurrent-runner cap is 20 and CI shares it; a sweep
# that took all twenty would stop the CI it exists to replace. Measured the hard way: `latchkey run`
# answered `Job creation blocked: concurrency_limit` on seven consecutive submissions while a CI
# push held the account.
LATCHKEY_MAX_JOBS=12
# AND IT BOUNDS *JOBS*. A pre-proof is a FAN now — build, gates, and the oracle when every line in
# the batch owes it — so twelve pre-proof processes would be up to thirty-six runners. The engine
# divides the job bound by this to get its process bound. Three is the widest fan.
LATCHKEY_JOBS_PER_PROOF=3
# THE RUNNER SIZE. `xlarge` is what the proofs were costed on (168 s cold workspace build on 32
# vCPU) and it answered `launch_failed: VcpuLimitExceeded` four times in one night; `large` is what
# is actually available and it is roughly 1.4x the wall clock. Raise with Latchkey beside the
# 20 -> 40 cap request, then put this back.
LATCHKEY_SIZE=large
# THE PER-JOB CEILING, WHICH IS LATCHKEY'S AND NOT NEGOTIABLE. It is here so the number an operator
# reads in a `NONE:cap` line is the number the engine used. A job that reaches it is killed
# mid-leg; the engine records NONE:cap (its own fault class), the line stays live, and the FIX is a
# plan with more jobs in it, never a longer job.
LATCHKEY_TIMEOUT=7200
# SHARD THE PRE-PROOF (0 = one job, exactly as before the split). The gate self-test batteries have
# been measured at 4,900 s and they are what walked past the ceiling on `large`; with this on they
# are a job of their own and the build never waits for them.
LATCHKEY_PREPROVE_SHARDS=1
# HOW MANY JOBS THE LANDING'S ORACLE IS SPLIT INTO. A full oracle run over every family was 2.2 h
# SERIAL on a fleet box, which does not fit under the ceiling at all.
LAND_LATCHKEY_SHARDS=4

# ── BIG-BATCH MODE (owner ruling, 2026-09-11) ─────────────────────────────────────────────────────
# The pop takes EVERY line whose picks apply cleanly onto the tip plus the batch so far, in queue
# order, and chains it as ONE unit so land.sh's prefix bisect attributes a red to the line that
# carries it. The one-file, one-gates-line and raise-beside-lower rules are dropped; no pre-proof is
# needed to join. A line that does not apply is NONE:no-apply — live, unparked, offered again at the
# next tip. `LAND_BIG_BATCH=0` is the way back to the admission-rule popper.
#
# MEASURED on the real 717-line queue at tip 3236c8a2b: 12 lines in one batch, where the rules
# popper takes 1-2.
LAND_BIG_BATCH=1
LAND_BATCH_MAX=40
# HOW DEEP THE PROVENANCE SEARCH GOES. A `#HOLD-after-<sha>` releases when the sha is an ancestor of
# HEAD *or* when a landed commit carries its `(cherry picked from commit <sha>)` trailer — and this
# tree lands by cherry-pick, so the second is the arm that matters. It is a DEPTH and not a rev
# range for one measured reason: every range the engine tried (`landq4.tip..HEAD`,
# `origin/<BR>..HEAD`) is EMPTY on a healthy runner, because both are written after every batch.
LANDQ_PROVENANCE_DEPTH=2000

# ── WHERE A LATCHKEY JOB'S LOG IS KEPT, PAST LATCHKEY'S 24 HOURS ─────────────────────────────────
# ONE FIXED PATH, NOT A DERIVATION. The scripts used to walk from the tree being proved to the main
# repository's parent, which is right for the runner tree and wrong for every other LANDQ_ROOT: the
# landing smoke on a scratch clone kept its job logs beside the SCRATCH, where no ledger reads them
# and nothing preserves them. The ledgers cite these logs by path months later.
LATCHKEY_LOG_DIR=$HOME/Developer/GetBusbar/busbar-landq-state/gate/latchkey-logs
