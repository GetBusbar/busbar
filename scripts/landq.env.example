# THE ENGINE'S ENVIRONMENT — ONE FILE, COPIED TO ~/.busbar-engine/env (F1)
# ──────────────────────────────────────────────────────────────────────────────────────────────────
# Until today the runner was restarted by hand with a fifteen-variable command line re-typed out of
# the ledger at every adoption, and every re-typing was a chance to drop a knob (measured: a
# BUSBAR_PROVE_PER_BOX=2 that outlived the box size it was measured for, and a LANDQ_PREPROVE_LINES
# left at 6 while the sweep had eighteen boxes). The restart line is now THIS FILE, and the one
# command is `bash scripts/landq-supervisor.sh`.
#
#   cp scripts/landq.env.example ~/.busbar-engine/env    # then edit the values below
#
# GRAMMAR: `NAME=value`, one per line, blank lines and `#` comments ignored. Nothing else — no
# command substitution, no pipelines, no `export` (the supervisor exports every name it reads).
# A VALUE WITH A SPACE IN IT MUST BE QUOTED (`NAME="a b"`): the file is sourced, so an unquoted
# space is a second word, and a second word is a command nobody meant to run.
# The supervisor refuses to start on a line that is not an assignment rather than sourcing it.
# `$HOME` and `$PATH` expand; they are read by the shell that starts the runner.
#
# WHAT IS *NOT* HERE: LAND_SH_SRC. The engine's own location is not an operator's choice any more —
# the supervisor sets it to ~/.busbar-engine/current/scripts, which is a `git archive` of the
# landed tip's scripts/ at the sha in ~/.busbar-engine/sha. Adoption is a landing (see
# docs/ci/landing-engine.md); a hand-staged copy under land-fanout-<sha> is not the engine.

# ── the tree the runner lands into ────────────────────────────────────────────────────────────────
LANDQ_ROOT=$HOME/Developer/GetBusbar/busbar/.claude/worktrees/config-seam-work
# ── scratch: never /tmp, never TMPDIR (owner rule, 2026-09-11) ────────────────────────────────────
LAND_TMP=$HOME/Developer/tmp
PATH=$HOME/.local/bin:$PATH
AWS_REGION=us-east-1

# ── the batch ─────────────────────────────────────────────────────────────────────────────────────
LAND_BATCH=8
LAND_CHAIN_DEPTH=8
LAND_SELFTEST_SHARDS=1
LAND_REMOTE=auto
XTASK_GATE_CEILING_SECS=3600

# ── the pre-prove sweep (never wider than the fleet's proof slots) ────────────────────────────────
LANDQ_PREPROVE_LINES=12
LANDQ_PREPROVE_HEAD=2
BUSBAR_PROVE_SEED=copy

# ── the fleet, FLEET-2's stop/start posture (an idle box is STOPPED, not paid for) ────────────────
# PER_BOX is a MEASUREMENT, not a preference: one proof per 32 vCPU (c7a.16xlarge = 2).
BUSBAR_PROVE_PER_BOX=2
LANDQ_IDLE_STOP_MINS=15
CI_RUNNER_ITYPE=c7a.16xlarge
CI_RUNNER_ONDEMAND_FLOOR=10
CI_RUNNER_RUNNING_MIN=2
CI_RUNNER_RUNNING_MAX=10

# ── the two HALTs (see the exit-code contract in docs/ci/landing-engine.md) ───────────────────────
# How many tree-moved refusals in a row are a fact about the tree rather than a stray process.
LANDQ_TREE_MOVED_HALT_AFTER=5
