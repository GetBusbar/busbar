{"applied":["hdr.date"],"body":{"text":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Sign in \u00b7 Busbar</title>\n<style>\n  :root {\n    --bg: #f4f6f4;\n    --card: #ffffff;\n    --ink: #0b1220;\n    --ink-soft: #1e293b;\n    --muted: #64748b;\n    --line: #e4e8e6;\n    --line-strong: #d3dad6;\n    --lime: #a3e635;\n    --limed: #4d7c0f;\n    --lime-deep: #35510b;\n    --field: #f8fafc;\n    --key-bg: #0f172a;\n    --key-ink: #e6f5c8;\n    --shadow: 0 1px 2px rgba(11,18,32,.04), 0 12px 32px -12px rgba(11,18,32,.16);\n    --focus: #4d7c0f;\n    --good: #4d7c0f;\n    --err-bg: #fee2e2;\n    --err-ink: #b91c1c;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root {\n      --bg: #0a0e0a;\n      --card: #12171a;\n      --ink: #f1f5f0;\n      --ink-soft: #cbd5cc;\n      --muted: #8b978c;\n      --line: #232b26;\n      --line-strong: #2e3830;\n      --lime: #a3e635;\n      --limed: #a3e635;\n      --lime-deep: #bef264;\n      --field: #0e1412;\n      --key-bg: #06090a;\n      --key-ink: #cdee97;\n      --shadow: 0 1px 2px rgba(0,0,0,.4), 0 18px 40px -16px rgba(0,0,0,.6);\n      --focus: #a3e635;\n      --good: #a3e635;\n      --err-bg: #3a1518;\n      --err-ink: #fca5a5;\n    }\n  }\n\n  * { box-sizing: border-box; }\n  html, body { margin: 0; }\n  body {\n    background: var(--bg);\n    color: var(--ink);\n    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n    line-height: 1.5;\n    -webkit-font-smoothing: antialiased;\n    min-height: 100vh;\n    padding: 40px 20px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 40px;\n  }\n  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n\n  /* \u2500\u2500 card \u2500\u2500 */\n  .stack { display: flex; flex-direction: column; align-items: center; gap: 40px; width: 100%; }\n  .card {\n    width: 100%; max-width: 400px;\n    background: var(--card);\n    border: 1px solid var(--line);\n    border-radius: 16px;\n    box-shadow: var(--shadow);\n    padding: 34px 32px 26px;\n    animation: rise .5s cubic-bezier(.2,.7,.3,1) both;\n  }\n  @keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }\n  @media (prefers-reduced-motion: reduce) { .card { animation: none; } }\n\n  /* \u2500\u2500 brand lockup \u2500\u2500 */\n  .brand { display: flex; align-items: center; gap: 11px; margin-bottom: 26px; }\n  .glyph {\n    width: 38px; height: 38px; border-radius: 10px; background: #0f172a;\n    display: grid; place-items: center; flex: 0 0 auto;\n    box-shadow: inset 0 0 0 1px rgba(163,230,53,.14);\n  }\n  .glyph svg { width: 30px; height: 30px; display: block; }\n  .wordmark { font-size: 19px; font-weight: 680; letter-spacing: -.015em; color: var(--ink); }\n  .wordmark span { color: var(--muted); font-weight: 500; }\n\n  h1 { font-size: 21px; line-height: 1.25; margin: 0 0 7px; letter-spacing: -.02em; text-wrap: balance; }\n  .sub { margin: 0 0 24px; color: var(--muted); font-size: 14px; }\n\n  /* \u2500\u2500 provider buttons \u2500\u2500 */\n  .providers { display: flex; flex-direction: column; gap: 10px; }\n  .provider {\n    display: flex; align-items: center; gap: 12px;\n    width: 100%; padding: 12px 16px;\n    background: var(--field);\n    border: 1px solid var(--line-strong);\n    border-radius: 10px;\n    color: var(--ink); font-size: 14.5px; font-weight: 560;\n    cursor: pointer; text-decoration: none;\n    transition: border-color .15s, background .15s, transform .06s;\n  }\n  .provider:hover { border-color: var(--limed); background: var(--card); }\n  .provider:active { transform: translateY(1px); }\n  .provider:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\n  .provider .picon { width: 20px; height: 20px; flex: 0 0 auto; }\n  .provider .plabel { flex: 1; }\n  .provider .chev { color: var(--muted); width: 16px; height: 16px; flex: 0 0 auto; }\n\n  .foot {\n    margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line);\n    color: var(--muted); font-size: 12.5px; line-height: 1.55;\n  }\n  .foot .mono { color: var(--ink-soft); font-size: 12px; }\n\n  /* \u2500\u2500 key-issued screen \u2500\u2500 */\n  .issued-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }\n  .check {\n    width: 24px; height: 24px; border-radius: 50%; background: var(--lime);\n    display: grid; place-items: center; flex: 0 0 auto;\n  }\n  .check svg { width: 13px; height: 13px; color: #0f172a; }\n  .keyrow {\n    display: flex; align-items: stretch; gap: 0; margin: 6px 0 8px;\n    border: 1px solid var(--line-strong); border-radius: 10px; overflow: hidden;\n    background: var(--key-bg);\n  }\n  .keyval {\n    flex: 1; min-width: 0; padding: 12px 14px; color: var(--key-ink);\n    font-size: 13px; letter-spacing: .01em; overflow-x: auto; white-space: nowrap;\n    display: flex; align-items: center;\n  }\n  .copy {\n    flex: 0 0 auto; border: 0; border-left: 1px solid rgba(255,255,255,.1);\n    background: transparent; color: var(--lime); font-weight: 600; font-size: 12.5px;\n    padding: 0 16px; cursor: pointer; font-family: inherit;\n    display: flex; align-items: center; gap: 6px;\n  }\n  .copy:hover { background: rgba(163,230,53,.1); }\n  .copy:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }\n  .copy svg { width: 14px; height: 14px; flex: 0 0 auto; }\n  .copy.copied { color: var(--good); }\n  /* BYOK-block copy button (light card background). */\n  .useinrow { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin: 0 0 8px; }\n  .useinrow .usein { margin: 0; }\n  .copymini {\n    flex: 0 0 auto; display: inline-flex; align-items: center; gap: 5px;\n    border: 1px solid var(--line-strong); background: var(--field);\n    color: var(--limed); font-weight: 600; font-size: 12px; font-family: inherit;\n    border-radius: 8px; padding: 6px 10px; cursor: pointer;\n  }\n  .copymini:hover { border-color: var(--limed); background: var(--card); }\n  .copymini:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\n  .copymini svg { width: 13px; height: 13px; flex: 0 0 auto; }\n  .copymini.copied { color: var(--good); border-color: var(--good); }\n  /* Quiet, secondary \"Sign out\" link on the key-issued page (a safe exit, not the main CTA). */\n  .signout {\n    display: inline-flex; align-items: center; gap: 6px; margin-top: 14px;\n    color: var(--muted); font-size: 12.5px; font-weight: 600; text-decoration: none;\n  }\n  .signout:hover { color: var(--ink-soft); text-decoration: underline; }\n  .signout:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }\n  .signout svg { width: 14px; height: 14px; flex: 0 0 auto; }\n  .reshow {\n    display: flex; align-items: center; gap: 7px;\n    color: var(--muted); font-size: 12.5px; font-weight: 500; margin-bottom: 20px;\n  }\n  .reshow a { color: var(--limed); font-weight: 600; text-decoration: none; }\n  .reshow a:hover { text-decoration: underline; }\n  .reshow svg { width: 14px; height: 14px; flex: 0 0 auto; }\n\n  .budget {\n    display: flex; gap: 10px; margin-bottom: 20px;\n  }\n  .tier {\n    flex: 1; background: var(--field); border: 1px solid var(--line);\n    border-radius: 10px; padding: 11px 13px;\n  }\n  .tier .tname { font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); font-weight: 600; }\n  .tier .tval { font-size: 17px; font-weight: 680; letter-spacing: -.01em; margin-top: 2px; font-variant-numeric: tabular-nums; }\n  .tier .tval small { font-size: 12px; font-weight: 500; color: var(--muted); }\n\n  .usein { color: var(--muted); font-size: 12.5px; margin: 0 0 8px; }\n  .snippet {\n    background: var(--key-bg); border: 1px solid var(--line-strong); border-radius: 10px;\n    padding: 13px 14px; color: var(--key-ink); font-size: 12px; line-height: 1.7;\n    overflow-x: auto;\n  }\n  .snippet .k { color: var(--muted); }\n  .snippet .v { color: var(--key-ink); }\n  /* Credential-login form (the Prompt shape). */\n  .credform { display: flex; flex-direction: column; gap: 12px; margin-top: 6px; }\n  .credform .flabel { display: flex; flex-direction: column; gap: 5px; font-size: 13px; color: var(--muted); text-align: left; }\n  .credform .finput {\n    background: var(--card); border: 1px solid var(--line-strong); border-radius: 10px;\n    padding: 11px 12px; color: var(--ink); font-size: 14px;\n  }\n  .credform .finput:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; border-color: var(--limed); }\n  .credform button.provider { justify-content: center; margin-top: 4px; }\n\n\n  /* \u2500\u2500 error screen \u2500\u2500 */\n  .errhead { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }\n  .erricon {\n    width: 24px; height: 24px; border-radius: 50%; background: var(--err-bg); color: var(--err-ink);\n    display: grid; place-items: center; flex: 0 0 auto;\n  }\n  .erricon svg { width: 14px; height: 14px; }\n  .backlink {\n    display: inline-flex; align-items: center; gap: 6px; margin-top: 20px;\n    color: var(--limed); font-weight: 600; font-size: 13.5px; text-decoration: none;\n  }\n  .backlink:hover { text-decoration: underline; }\n  .backlink:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }\n  .backlink svg { width: 15px; height: 15px; flex: 0 0 auto; }\n</style>\n<script>\n  // One-click copy for the key-issued page. Self-contained, no external libs. Uses the async\n  // Clipboard API (works over https AND http://localhost \u2014 localhost is a secure context), with a\n  // document.execCommand('copy') fallback for non-secure contexts / older browsers. On success the\n  // button label briefly swaps to \"Copied!\". The value copied is read from the button's data-copy\n  // attribute (the browser decodes HTML entities \u2014 e.g. &#10; \u2192 newline \u2014 on read).\n  function bbCopy(btn) {\n    var text = btn.getAttribute('data-copy') || '';\n    function done() {\n      var label = btn.querySelector('.clabel');\n      if (!label) return;\n      var prev = label.textContent;\n      btn.classList.add('copied');\n      label.textContent = 'Copied!';\n      setTimeout(function () {\n        btn.classList.remove('copied');\n        label.textContent = prev;\n      }, 1500);\n    }\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(text).then(done, function () { bbCopyFallback(text, done); });\n    } else {\n      bbCopyFallback(text, done);\n    }\n  }\n  function bbCopyFallback(text, done) {\n    try {\n      var ta = document.createElement('textarea');\n      ta.value = text;\n      ta.setAttribute('readonly', '');\n      ta.style.position = 'fixed';\n      ta.style.top = '-9999px';\n      document.body.appendChild(ta);\n      ta.focus();\n      ta.select();\n      document.execCommand('copy');\n      document.body.removeChild(ta);\n      done();\n    } catch (e) { /* clipboard unavailable \u2014 leave the value visible for manual copy */ }\n  }\n</script>\n</head><body><div class=\"stack\"><div class=\"card\"><div class=\"brand\"><span class=\"glyph\"><svg viewBox=\"0 0 128 128\" xmlns=\"http://www.w3.org/2000/svg\" style=\"color:#A3E635\" aria-hidden=\"true\"><g transform=\"translate(64 64) scale(1.46) translate(-62 -64)\"><g transform=\"translate(3 0)\"><rect x=\"46\" y=\"39\" width=\"9\" height=\"50\" rx=\"4.5\" fill=\"currentColor\"/><g stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"36\" y1=\"64\" x2=\"41\" y2=\"64\" stroke-width=\"5\"/><path d=\"M60 45 L79 45 Q87 45 87 55\" stroke-width=\"5\"/><line x1=\"60\" y1=\"64\" x2=\"72\" y2=\"64\" stroke-width=\"5\"/><path d=\"M60 83 L79 83 Q87 83 87 73\" stroke-width=\"5\"/></g><g fill=\"currentColor\"><circle cx=\"31\" cy=\"64\" r=\"4.6\"/><circle cx=\"87\" cy=\"55\" r=\"4.6\"/><circle cx=\"76\" cy=\"64\" r=\"4.6\"/><circle cx=\"87\" cy=\"73\" r=\"4.6\"/></g></g></g></svg></span><span class=\"wordmark\">Busbar</span></div><h1>Get your API key</h1><p class=\"sub\">Sign in with your organization account. Busbar issues a personal key scoped to your budget.</p><p class=\"sub\">No browser login is configured. Ask your Busbar admin, or use the headless <span class=\"mono\">POST /auth/token</span> exchange.</p></div></div></body></html>"},"effects":{"audit":{"added":0,"items":[]},"egress":[],"metrics":{},"usage":{}},"headers":{"cache-control":"no-store","content-length":"12052","content-type":"text/html; charset=utf-8"},"status":200}
