#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2026 Busbar Inc and contributors
#
# The shadow oracle is a separate product now. This is the ONE piece of glue busbar keeps: it
# obtains the PINNED Rust `busbar-oracle` engine and runs it against this checkout's data.
#
# PHASE C CUTOVER (branch-only): the money oracle is now the Rust `busbar-oracle` crate that lives in
# GetBusbar/busbar-release. This shim obtains that binary from the pin the branch file's env names
# (BUSBAR_ORACLE_RELEASE_REPO / _REF / _SHA256_LINUX_* / _CRATE / _BIN), held to its sha256 (an unpinned
# judge is not a judge; money integrity). The argv
# contract is UNCHANGED (cells / record / replay / diff / normalize / merge / renormalize /
# harness-rev / fetch-golden / fetch-plugin / replay-selftest / selftest / tool-dir),
# so every caller (`./bin/oracle <sub>`, busbar-release-oracle's HarnessOracle) is unchanged.
#
# TOOL_DIR is a SHIM directory this shim generates beside the binary: `record.sh` there forwards to
# `busbar-oracle record --native` so busbar-release-oracle's HarnessOracle — which drives
# `$BUSBAR_ORACLE_TOOL_DIR/record.sh` — records 100% natively without a code change; replay is already
# the in-process Rust differ.
#
# THE PRODUCT DATA-DRIVERS NO LONGER SHELL OUT TO PYTHON. `testing/shadow-oracle/scripts/*.sh` used
# to call `python3 $BUSBAR_ORACLE_TOOL_DIR/{mock-upstream,capture-exec,capture}.py` and
# `bash $BUSBAR_ORACLE_TOOL_DIR/fetch-plugin.sh` — files the Rust tool dir does not contain, so all 33
# script-driven cells recorded NOTHING and each one logged itself as a `named gap` rather than a
# failure. They now call this binary's own subcommands through BUSBAR_ORACLE_BIN (exported below),
# and `oracle-config.sh` — the one file they still SOURCE — is materialized from the engine.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# THE CACHES' HOME: ModernCI's per-check cache dir when it names one, else this checkout's target/.
# Never $HOME/.cache: every concurrent job on a backend shares it (ModernCI #1827).
cache_home="${MODERNCI_CACHE_DIR:-$here/target}"

# ── A FILTERED RUN CARRIES ITS FORGIVENESSES' PREMISES ──────────────────────────────────────────
# An accepted difference forgives its cells only once its PREMISE holds, and the premise probes other
# cells. A record or replay narrowed by a filter that leaves a premise cell out cannot evaluate it, so
# the engine WITHHOLDS the owner-signed forgiveness and reports its cells FAIL — a false red that
# reads exactly like a regression (24 Q40 cells, 2026-09-27, from a filter missing
# `ops.scrape|metrics|key`). So a filter is widened here to every premise cell of every accepted
# difference whose cells it selects, and a premise that names a cell the corpus does not have is a
# refusal naming it. After a filtered replay, a forgiveness still withheld for an unevaluable
# premise the filter selected is a refusal too, never a FAIL row.
premise_closure() {  # premise_closure <filter> -> the premise cells the filter's forgivenesses need
  python3 - "$1" "${BUSBAR_ORACLE_DATA:-$here/testing/shadow-oracle}" <<'PY'
import json, re, sys
flt, data = sys.argv[1], sys.argv[2]
ids = [c["id"] for c in json.load(open(f"{data}/cells.json"))["cells"]]
universe = set(ids)
try:
    sel = re.compile(flt)
except re.error as e:
    sys.exit(f"oracle: the filter {flt!r} is not a regex this shim can widen ({e})")
selected = [i for i in ids if sel.search(i)]
def cells_of(node, out):
    if isinstance(node, dict):
        if isinstance(node.get("cell"), str):
            out.add(node["cell"])
        for v in node.values():
            cells_of(v, out)
    elif isinstance(node, list):
        for v in node:
            cells_of(v, out)
need, bad = set(), []
for e in json.load(open(f"{data}/accepted-differences.json"))["accepted"]:
    if not e.get("premise") or not e.get("cells"):
        continue
    try:
        pat = re.compile(e["cells"])
    except re.error:
        continue
    if not any(pat.search(i) for i in selected):
        continue
    probes = set()
    cells_of(e["premise"], probes)
    for c in sorted(probes):
        if c not in universe:
            bad.append(f"{e.get('id')!r} probes premise cell {c!r}, which cells.json does not have")
        elif not sel.search(c):
            need.add(c)
if bad:
    sys.exit("oracle: a filtered run cannot evaluate a forgiveness it selects:\n  " + "\n  ".join(bad))
print("\n".join(sorted(need)))
PY
}
widen_filter() {  # widen_filter <filter> -> the filter plus the premise cells it needs
  local extra
  extra="$(premise_closure "$1")" || exit 3
  if [ -z "$extra" ]; then printf '%s\n' "$1"; return; fi
  local alt
  alt="$(printf '%s\n' "$extra" | python3 -c 'import re,sys; print("|".join(re.escape(l.strip()) for l in sys.stdin if l.strip()))')"
  echo "oracle: the filter is widened to the premise cells its accepted differences probe: $(printf '%s' "$extra" | tr '\n' ' ')" >&2
  printf '(?:%s)|^(?:%s)$\n' "$1" "$alt"
}
# withheld_selected <engine-output-file> <filter> -> nonzero, naming each, when a forgiveness the
# filter selected was withheld because its premise could not be evaluated.
withheld_selected() {
  local closure
  closure="$(premise_closure "$2")" || return 3
  python3 - "$1" "$2" "$closure" <<'PY'
import re, sys
out, flt, closure = sys.argv[1], sys.argv[2], set(filter(None, sys.argv[3].split("\n")))
sel = re.compile(flt)
hits = []
for line in open(out, errors="replace"):
    m = re.search(r"entry (.+?) is WITHHELD .*premise UNEVALUABLE: premise probes cell \"([^\"]+)\"", line)
    if m and (m.group(2) in closure or sel.search(m.group(2))):
        hits.append(f"{m.group(1)} (premise cell {m.group(2)!r})")
if hits:
    print("oracle: a filtered replay could not evaluate the premise of a forgiveness it selected, so "
          "its cells would report FAIL for a difference the owner signed. Refusing instead:\n  "
          + "\n  ".join(hits) + "\nRecord the premise cells (bin/oracle record widens its --filter "
          "to them) and replay again.", file=sys.stderr)
    sys.exit(3)
PY
}
if [ "${1:-}" = "premise-filter" ]; then widen_filter "${2:?premise-filter <filter>}"; exit 0; fi

# ── ONE ORACLE RUN, SHARDED BY CELL ─────────────────────────────────────────────────────────────
# The corpus is split into N shards so one run spreads over N machines (ModernCI checks oracle-1..N),
# each recording and replaying ITS cells, as strict as the whole run: a shard exits non-zero on any
# unsigned FAIL (the replay's own exit), and `shard-verify` refuses a shard whose report did not
# select every cell it owns. The split is the corpus's ids in sorted order, the i-th to shard
# i mod N + 1: deterministic, and it spreads every family over every shard. `shard-cover` (the cheap
# `oracle` check, after every shard) proves the N filters the shards ran select every id in
# cells.json exactly once, so the union of the shards is the whole corpus. A shard's filter is
# widened to the premise cells its forgivenesses probe (as any filtered run is), so a premise cell
# may be judged again, as context, in another shard: never fewer judgements, never a weaker one.
shard_ids() {  # shard_ids <k> <n> -> the ids shard k of n owns, one per line
  python3 - "$1" "$2" "${BUSBAR_ORACLE_DATA:-$here/testing/shadow-oracle}" <<'PY'
import json, sys
k, n, data = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
if not (n >= 1 and 1 <= k <= n):
    sys.exit(f"oracle: shard {k} of {n} is not a shard (1 <= k <= n)")
ids = sorted(c["id"] for c in json.load(open(f"{data}/cells.json"))["cells"])
print("\n".join(i for x, i in enumerate(ids) if x % n == k - 1))
PY
}
shard_filter() {  # shard_filter <k> <n> -> the anchored regex selecting exactly shard k's ids
  shard_ids "$1" "$2" | python3 -c 'import re,sys; ids=[l.rstrip("\n") for l in sys.stdin if l.strip()]; print("^(?:" + "|".join(re.escape(i) for i in ids) + ")$")'
}
if [ "${1:-}" = "shard-filter" ]; then shard_filter "${2:?shard-filter <k> <n>}" "${3:?shard-filter <k> <n>}"; exit 0; fi
if [ "${1:-}" = "shard-cover" ]; then
  n="${2:?shard-cover <n>}"
  # The N filters together name every id, more than one argv string may hold (Linux caps one at
  # 128 KiB), so they reach python through a file.
  filters="$(mktemp)" || exit 3
  for k in $(seq 1 "$n"); do shard_filter "$k" "$n" >>"$filters" || { rm -f "$filters"; exit 3; }; done
  python3 - "$n" "${BUSBAR_ORACLE_DATA:-$here/testing/shadow-oracle}" "$filters" <<'PY' || { rm -f "$filters"; exit 3; }
import json, re, sys
n, data = int(sys.argv[1]), sys.argv[2]
filters = open(sys.argv[3]).read().rstrip("\n").split("\n")
ids = [c["id"] for c in json.load(open(f"{data}/cells.json"))["cells"]]
if len(filters) != n:
    sys.exit(f"oracle shard-cover: {len(filters)} filters for {n} shards")
rx = [re.compile(f) for f in filters]
bad = []
for i in ids:
    hits = [k + 1 for k, r in enumerate(rx) if r.search(i)]
    if len(hits) != 1:
        bad.append(f"{i!r} is selected by shard(s) {hits or 'none'}")
if len(set(ids)) != len(ids):
    bad.append("cells.json repeats an id")
if bad:
    sys.exit("oracle shard-cover: the shards do not cover the corpus exactly once:\n  " + "\n  ".join(bad[:20]))
print(f"oracle shard-cover: {n} shards select all {len(ids)} cells of cells.json, each exactly once")
PY
  rm -f "$filters"
  exit 0
fi
if [ "${1:-}" = "shard-verify" ]; then
  k="${2:?shard-verify <k> <n> <report-dir>}" n="${3:?shard-verify <k> <n> <report-dir>}" rep="${4:?shard-verify <k> <n> <report-dir>}"
  owned="$(mktemp)" || exit 3
  shard_ids "$k" "$n" >"$owned" || { rm -f "$owned"; exit 3; }
  python3 - "$k" "$n" "$rep" "$owned" <<'PY' || { rm -f "$owned"; exit 3; }
import sys
k, n, rep = sys.argv[1], sys.argv[2], sys.argv[3]
owned = set(filter(None, open(sys.argv[4]).read().split("\n")))
try:
    selected = set(filter(None, open(f"{rep}/selected-ids.txt").read().split("\n")))
except OSError as e:
    sys.exit(f"oracle shard-verify: shard {k}/{n} wrote no selected-ids.txt ({e}); nothing proves what it judged. Refusing.")
missing = sorted(owned - selected)
if not owned:
    sys.exit(f"oracle shard-verify: shard {k}/{n} owns no cell. Refusing.")
if missing:
    sys.exit(f"oracle shard-verify: shard {k}/{n} did not select {len(missing)} of its {len(owned)} cells: {missing[:10]}. Refusing.")
print(f"oracle shard-verify: shard {k}/{n} selected all {len(owned)} cells it owns")
PY
  rm -f "$owned"
  exit 0
fi
# shard-selftest: each guard refuses what it exists to refuse, before its green is trusted.
if [ "${1:-}" = "shard-selftest" ]; then
  st="$(mktemp -d)"; trap 'rm -rf "$st"' EXIT; fail=0
  ok() { echo "  [ok]     $1"; }; bad() { echo "  [FAILED] $1"; fail=1; }
  printf '%s' '{"cells":[{"id":"a|1"},{"id":"a|2"},{"id":"b|1"},{"id":"b|2"},{"id":"c|1"}]}' >"$st/cells.json"
  printf '%s' '{"accepted":[]}' >"$st/accepted-differences.json"
  me=("$here/bin/oracle")
  BUSBAR_ORACLE_DATA="$st" bash "${me[@]}" shard-cover 2 >/dev/null 2>&1 \
    && ok "two shards cover five cells exactly once" || bad "a sound split was refused"
  for n in 1 3 5 7; do
    BUSBAR_ORACLE_DATA="$st" bash "${me[@]}" shard-cover "$n" >/dev/null 2>&1 || bad "$n shards: a sound split was refused"
  done
  printf '%s' '{"cells":[{"id":"a|1"},{"id":"a|2"},{"id":"a|1"}]}' >"$st/dup.json"
  mkdir -p "$st/dup"; cp "$st/dup.json" "$st/dup/cells.json"; cp "$st/accepted-differences.json" "$st/dup/"
  BUSBAR_ORACLE_DATA="$st/dup" bash "${me[@]}" shard-cover 2 >/dev/null 2>&1 \
    && bad "a corpus that repeats an id was covered" || ok "a corpus that repeats an id is refused"
  BUSBAR_ORACLE_DATA="$st" bash "${me[@]}" shard-filter 3 2 >/dev/null 2>&1 \
    && bad "shard 3 of 2 answered a filter" || ok "a shard outside 1..n is refused"
  mkdir -p "$st/rep"
  BUSBAR_ORACLE_DATA="$st" bash "${me[@]}" shard-verify 1 2 "$st/rep" >/dev/null 2>&1 \
    && bad "a shard with no report was verified" || ok "a shard that wrote no report is refused"
  printf 'a|1\nb|1\n' >"$st/rep/selected-ids.txt"
  BUSBAR_ORACLE_DATA="$st" bash "${me[@]}" shard-verify 1 2 "$st/rep" >/dev/null 2>&1 \
    && bad "a shard missing one of its cells was verified" || ok "a shard that did not select a cell it owns is refused"
  printf 'a|1\nb|1\nc|1\nb|2\n' >"$st/rep/selected-ids.txt"
  BUSBAR_ORACLE_DATA="$st" bash "${me[@]}" shard-verify 1 2 "$st/rep" >/dev/null 2>&1 \
    && ok "a shard that selected all it owns (and premise context) is verified" || bad "a complete shard was refused"
  [ "$fail" = 0 ] && { echo "oracle shard-selftest: the shards cover the corpus exactly once, and a shard that judged less is red"; exit 0; }
  echo "oracle shard-selftest: FAILED"; exit 1
fi
# `--filter` is record's flag; replay and diff select with `--id-filter`. Refused by name, before
# anything runs (2026-10-07: a replay handed it judged nothing and printed only its fence rows).
refuse_filter_flag() {  # refuse_filter_flag <subcommand>
  echo "oracle: $1 takes --id-filter <regex>; --filter is record's flag. Refusing: nothing was judged." >&2
  exit 2
}

# ── A RECORDING OWNS ITS TEMP DIRECTORY ─────────────────────────────────────────────────────────
# Every busbar the recorder boots sweeps `<TMPDIR>` at startup for plugin staging dirs a dead pid
# left, and prints `[info] removed N orphaned plugin staging dir(s)…` on stderr when it finds any
# (1.5.5 and 1.6.0 alike). Inheriting the host TMPDIR made that line a function of whatever other
# busbar runs on the host had crashed: boot.refusal|BOOT-170 diverged on it (C3 measure, b14d0a1a4),
# and the 1.5.5 binary prints the same line under the same pollution. So a recording runs with
# TMPDIR at a fresh private directory (still under the host temp base, so the recorder's temp-path
# normalization is unchanged) and removes it afterwards, whatever the exit.
_ptmp=""
private_tmp() {  # private_tmp <cmd...>: run cmd with TMPDIR at a fresh private dir, removed after
  local base="${TMPDIR:-/tmp}" rc=0
  _ptmp="$(mktemp -d "${base%/}/busbar-oracle-tmp.XXXXXX")"
  trap 'rm -rf "$_ptmp"' EXIT
  TMPDIR="$_ptmp" "$@" || rc=$?
  rm -rf "$_ptmp"; trap - EXIT
  return "$rc"
}
if [ "${1:-}" = "private-tmp" ]; then shift; rc=0; private_tmp "$@" || rc=$?; exit "$rc"; fi
if [ "${1:-}" = "private-tmp-selftest" ]; then
  # Both record paths (`bin/oracle record` and the generated tool-dir record.sh) run against a copy
  # of this shim with a stub engine, from a host TMPDIR planted with dead-pid staging dirs in the
  # 1.5.5 and 1.6.0 layouts. The engine must see none of them, and its private dir must be gone.
  # An optional argument names the shim under test (a parent revision's, for the red proof).
  under="${2:-$here/bin/oracle}"
  st="$(mktemp -d)"; trap 'rm -rf "$st"' EXIT
  mkdir -p "$st/repo/bin" "$st/repo/testing/shadow-oracle" "$st/host" "$st/out"
  cp "$under" "$st/repo/bin/oracle"
  dead="$(sh -c 'echo $$')"
  mkdir -p "$st/host/busbar-plugins-$dead-x" "$st/host/busbar-plugin-staging-$(id -u)/busbar-plugins-$dead-x"
  cat >"$st/engine" <<'E'
#!/usr/bin/env bash
[ "$1" = record ] || exit 0
n="$(find "${TMPDIR:?}" -name 'busbar-plugins-*' 2>/dev/null | wc -l | tr -d ' ')"
echo "$TMPDIR $n" >>"$(dirname "$0")/seen"
E
  chmod +x "$st/engine"
  NOCI=(-u BUSBAR_ORACLE_JUDGE_PATH -u CI -u MODERNCI -u MODERNCI_JOB -u MODERNCI_TO_SHA -u MODERNCI_HEAD -u MODERNCI_COMMIT)
  env "${NOCI[@]}" -u ORACLE_LISTEN_PORT -u ORACLE_ADMIN_PORT -u ORACLE_MOCK_PORT TMPDIR="$st/host" \
    BUSBAR_ORACLE_RUST_BIN="$st/engine" "$st/repo/bin/oracle" record --bin /x --out "$st/out/a" >/dev/null 2>&1
  env "${NOCI[@]}" TMPDIR="$st/host" BUSBAR_ORACLE_RUST_BIN="$st/engine" \
    "$(find "$st/repo/target" -name record.sh | head -1)" --bin /x --out "$st/out/b" >/dev/null 2>&1
  fail=0; n=0
  while read -r dir cnt; do
    n=$((n + 1))
    case "$dir" in "$st/host"/busbar-oracle-tmp.*) ;; *) echo "  [FAILED] path $n: TMPDIR was not private: $dir"; fail=1;; esac
    [ "$cnt" = 0 ] || { echo "  [FAILED] path $n: the engine saw $cnt staging dir(s) from the host"; fail=1; }
    [ ! -e "$dir" ] || { echo "  [FAILED] path $n: the private TMPDIR outlived the run: $dir"; fail=1; }
  done <"$st/seen"
  [ "$n" = 2 ] || { echo "  [FAILED] expected 2 recordings (bin/oracle record, record.sh), saw $n"; fail=1; }
  [ -d "$st/host/busbar-plugins-$dead-x" ] || { echo "  [FAILED] the host's own temp entries were touched"; fail=1; }
  [ "$fail" = 0 ] && { echo "oracle private-tmp-selftest: each recording runs in its own private TMPDIR"; exit 0; }
  echo "oracle private-tmp-selftest: FAILED"; exit 1
fi
if [ "${1:-}" = "replay-refusal-selftest" ]; then
  # A replay that judged nothing is refused, never read as a verdict: `--filter` (record's flag) is
  # refused by name before the engine runs; an engine argument refusal stops the replay there; a
  # report that compared zero owed cells is refused (3); a report that compared some passes the
  # engine's exit through. Driven against a copy of this shim with a stub engine. An optional
  # argument names the shim under test (a parent revision's, for the red proof).
  under="${2:-$here/bin/oracle}"
  st="$(mktemp -d)"; trap 'rm -rf "$st"' EXIT
  mkdir -p "$st/repo/bin" "$st/repo/testing/shadow-oracle" "$st/out"
  cp "$under" "$st/repo/bin/oracle"
  printf '{"cells": [{"id": "fam|a"}]}\n' >"$st/repo/testing/shadow-oracle/cells.json"
  printf '{"accepted": []}\n' >"$st/repo/testing/shadow-oracle/accepted-differences.json"
  cat >"$st/engine" <<'E'
#!/usr/bin/env bash
[ "$1" = diff ] || exit 0
echo diff >>"$(dirname "$0")/calls"
out=""; prev=""; for a in "$@"; do [ "$prev" = --out ] && out="$a"; prev="$a"; done
case "${STUB:-}" in
  usage) echo "error: unexpected argument found" >&2; exit 2 ;;
  zero) mkdir -p "$out"; echo '{"totals": {"owed": 0}}' >"$out/report.json"; exit 0 ;;
  some) mkdir -p "$out"; echo '{"totals": {"owed": 3}}' >"$out/report.json"; exit 1 ;;
esac
E
  chmod +x "$st/engine"
  run() {  # run <stub mode> <replay args...> -> "<rc>" ; stderr to $st/err
    : >"$st/calls"
    env -u BUSBAR_ORACLE_DATA -u BUSBAR_ORACLE_JUDGE_PATH -u CI -u MODERNCI -u MODERNCI_JOB -u MODERNCI_TO_SHA -u MODERNCI_HEAD -u MODERNCI_COMMIT STUB="$1" BUSBAR_ORACLE_RUST_BIN="$st/engine" "$st/repo/bin/oracle" \
      replay "${@:2}" >/dev/null 2>"$st/err"; echo $?
  }
  fail=0
  rc="$(run some --candidate c --out "$st/out/f" --filter 'fam')"
  if [ "$rc" = 2 ] && grep -q -- "--id-filter" "$st/err" && [ ! -s "$st/calls" ]; then
    echo "  [ok]     replay --filter is refused by name before the engine runs"
  else echo "  [FAILED] replay --filter: rc=$rc, engine calls $(wc -l <"$st/calls"), $(head -c 200 "$st/err")"; fail=1; fi
  rc="$(run usage --candidate c --out "$st/out/u")"
  if [ "$rc" = 2 ] && grep -q "nothing was judged" "$st/err" && [ "$(wc -l <"$st/calls" | tr -d ' ')" = 1 ]; then
    echo "  [ok]     an engine argument refusal stops the replay; no other section runs"
  else echo "  [FAILED] engine refusal: rc=$rc, engine calls $(wc -l <"$st/calls"), $(head -c 200 "$st/err")"; fail=1; fi
  rc="$(run zero --candidate c --out "$st/out/z")"
  if [ "$rc" = 3 ] && grep -q "ZERO owed cells" "$st/err"; then
    echo "  [ok]     a replay that compared zero owed cells is refused"
  else echo "  [FAILED] zero judged: rc=$rc, $(head -c 200 "$st/err")"; fail=1; fi
  rc="$(run some --candidate c --out "$st/out/s")"
  if [ "$rc" = 1 ]; then echo "  [ok]     a replay that judged cells answers the engine's verdict"
  else echo "  [FAILED] judged: rc=$rc, $(head -c 200 "$st/err")"; fail=1; fi
  [ "$fail" = 0 ] && { echo "oracle replay-refusal-selftest: a replay that judged nothing is refused, never read as a verdict"; exit 0; }
  echo "oracle replay-refusal-selftest: FAILED"; exit 1
fi
if [ "${1:-}" = "premise-selftest" ]; then
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  cat >"$tmp/cells.json" <<'J'
{"cells": [{"id": "fam|forgiven"}, {"id": "fam|other"}, {"id": "probe|premise"}]}
J
  cat >"$tmp/accepted-differences.json" <<'J'
{"accepted": [{"id": "PLANT", "cells": "^fam\\|forgiven$", "premise": {"all": [{"cell": "probe|premise", "status": 200}]}}]}
J
  fail=0
  got="$(BUSBAR_ORACLE_DATA="$tmp" widen_filter '^fam\|forgiven$' 2>/dev/null)"
  if python3 -c 'import re,sys; r=re.compile(sys.argv[1]); sys.exit(0 if r.search("probe|premise") and r.search("fam|forgiven") and not r.search("fam|other") else 1)' "$got"; then
    echo "  [ok]     a filter selecting a forgiven cell but not its premise is widened to the premise"
  else echo "  [FAILED] the premise cell was not added to the filter: $got"; fail=1; fi
  got="$(BUSBAR_ORACLE_DATA="$tmp" widen_filter '^fam\|other$' 2>/dev/null)"
  if [ "$got" = '^fam\|other$' ]; then echo "  [ok]     a filter that selects no forgiven cell is left as it is"
  else echo "  [FAILED] an unrelated filter was widened: $got"; fail=1; fi
  sed -i.bak 's/probe|premise", "status"/probe|gone", "status"/' "$tmp/accepted-differences.json"
  if ( BUSBAR_ORACLE_DATA="$tmp" widen_filter '^fam\|forgiven$' ) >/dev/null 2>"$tmp/err"; then
    echo "  [FAILED] a premise naming a cell the corpus lacks was not refused"; fail=1
  elif grep -q "probe|gone" "$tmp/err"; then echo "  [ok]     a premise naming a cell the corpus lacks is refused, by name"
  else echo "  [FAILED] the refusal did not name the premise cell: $(cat "$tmp/err")"; fail=1; fi
  mv "$tmp/accepted-differences.json.bak" "$tmp/accepted-differences.json"
  printf "accepted-differences: entry 'PLANT' is WITHHELD — premise UNEVALUABLE: premise probes cell \"probe|premise\", which the build under test did not record\n" >"$tmp/out"
  if ( BUSBAR_ORACLE_DATA="$tmp" withheld_selected "$tmp/out" '^fam\|forgiven$' ) 2>"$tmp/err2"; then
    echo "  [FAILED] a withheld forgiveness the filter selected was not refused"; fail=1
  elif grep -q "probe|premise" "$tmp/err2"; then echo "  [ok]     a replay whose selected forgiveness was withheld refuses, naming the premise"
  else echo "  [FAILED] the replay refusal did not name the premise"; fail=1; fi
  if ( BUSBAR_ORACLE_DATA="$tmp" withheld_selected "$tmp/out" '^fam\|other$' ) 2>/dev/null; then
    echo "  [ok]     a withheld forgiveness the filter did not select is not this run's refusal"
  else echo "  [FAILED] an unselected withheld forgiveness refused the run"; fail=1; fi
  [ "$fail" = 0 ] && { echo "oracle premise-selftest: a filtered run evaluates its forgivenesses' premises or refuses by name"; exit 0; }
  echo "oracle premise-selftest: FAILED"; exit 1
fi

# THE JUDGE IS NAMED ONCE: by the branch file's env (BUSBAR_ORACLE_RELEASE_REPO / _REF / _SHA256_LINUX_* /
# _CRATE / _BIN, busbar's modernci-config .ci/default.yaml and .ci/dev.yaml). No file in the tree restates it,
# so a repin is one branch-file change; the judge's identity is its sha256, verified before every exec.
pin="(the branch file's BUSBAR_ORACLE_* env)"
RELEASE_REPO="${BUSBAR_ORACLE_RELEASE_REPO:-}"; RELEASE_REF="${BUSBAR_ORACLE_RELEASE_REF:-none}"
CRATE="${BUSBAR_ORACLE_CRATE:-busbar-release-oracle}"; BINNAME="${BUSBAR_ORACLE_BIN:-busbar-oracle}"

root="$here/target/oracle/rust/$RELEASE_REF"
shim_dir="$root/tool"
mkdir -p "$root"

# ── obtain the Rust engine ──────────────────────────────────────────────────────────────────────
# Precedence UNDER MODERNCI (resolve_bin): ModernCI's pre-fetched judge at $BUSBAR_ORACLE_JUDGE_PATH
# (no fetch, no token read), else NO JUDGE; BUSBAR_ORACLE_RUST_BIN is ignored, and no token is
# read, in any CI run (ci_run, below). Outside CI:
#   1. BUSBAR_ORACLE_RUST_BIN=<path>   a prebuilt binary chosen by the operator (verify-1.6.0-done.sh
#                                      refuses a DONE run with it set).
#   2. on Linux: THE FETCHED JUDGE      busbar-release's published `busbar-oracle-linux-<arch>-<ref>`,
#                                      run only when its sha256 is the BASE pin's line for this
#                                      architecture (fetch_judge, below). No line: no judge, refused.
#   3. elsewhere (a laptop): BUSBAR_RELEASE_CHECKOUT=<dir>, a busbar-release checkout to
#      `cargo build --release` from, else git clone busbar-release at the pinned ref, then build.
# ── the engine clone: a token is USED, never STORED (Q128 WARN, ARCHITECT 2026-10-05) ──────────────
# The token (a LOCAL run's only: release_token; a CI run reads none) reaches git as a
# one-shot `http.<github>.extraheader` through git's environment config (GIT_CONFIG_COUNT/KEY/VALUE):
# not in the clone URL, not on any argv, and never in the checkout's .git/config. It used to be folded
# into the URL as `x-access-token:<token>@`, which `git clone` wrote into `remote.origin.url` on disk,
# where it outlived the run. An existing checkout's origin is reset to the plain URL (scrubbing a URL a
# previous version stored), and after every clone/fetch `assert_no_token` refuses the run if the token
# or an `x-access-token` credential is anywhere in that config.
# ── A CI RUN READS NO TOKEN (OWNER 2026-10-26, "cut it"; G8: a move's checks receive no credential) ──
# In any CI run (a ModernCI marker, BUSBAR_ORACLE_JUDGE_PATH, or CI=) this shim never reads
# BUSBAR_RELEASE_TOKEN, GH_TOKEN or GITHUB_TOKEN, even when one is set: the judge is the file ModernCI's
# daemon fetched OUTSIDE the run from its tool pin (.ci/oracle-judge.pin) and handed over as
# $BUSBAR_ORACLE_JUDGE_PATH; the 1.5.5 golden is BUSBAR_GOLDEN_1_5_5_TREE from this checkout's own object
# database; the 1.5.5 reference binary and the plugins are public release assets the engine fetches
# with no token. release_token is the ONE reader of those names; outside CI it is the first one set.
ci_run() { [ -n "${BUSBAR_ORACLE_JUDGE_PATH:-}${MODERNCI:-}${MODERNCI_JOB:-}${MODERNCI_TO_SHA:-}${MODERNCI_HEAD:-}${MODERNCI_COMMIT:-}${CI:-}" ]; }
release_token() {  # release_token — the token a LOCAL run may use; in a CI run nothing, and 1
  ci_run && return 1
  local tok="${BUSBAR_RELEASE_TOKEN:-${GH_TOKEN:-${GITHUB_TOKEN:-}}}"
  [ -n "$tok" ] || return 1
  printf '%s' "$tok"
}
git_with_token() {  # git_with_token <git args...> — git, authenticated for github.com if a local run has a token
  local tok; tok="$(release_token)" || tok=""
  if [ -n "$tok" ]; then
    local b64; b64="$(printf 'x-access-token:%s' "$tok" | base64 | tr -d '\n')"
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" \
      GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $b64" git "$@"
  else
    git "$@"
  fi
}
assert_no_token() {  # assert_no_token <checkout> — refuse if a credential persisted in its git config
  local cfg="$1/.git/config" tok; tok="$(release_token)" || tok=""
  [ -f "$cfg" ] || return 0
  if grep -qiE 'x-access-token|extraheader|://[^/@[:space:]]+@' "$cfg" || { [ -n "$tok" ] && grep -qF -- "$tok" "$cfg"; }; then
    echo "oracle: a credential persisted in $cfg; refusing (the engine clone must never store a token)" >&2
    return 1
  fi
}
clone_engine() {  # clone_engine <checkout> — the pinned busbar-release ref, checked out, no token stored
  local checkout="$1"
  if [ ! -d "$checkout/.git" ]; then
    git_with_token clone --no-checkout "$RELEASE_REPO" "$checkout" >&2
  else
    git -C "$checkout" remote set-url origin "$RELEASE_REPO" >&2 2>/dev/null || true
  fi
  # A checkout that already holds the pinned commit needs no network: a Latchkey runner has no
  # token, so a fetch there fails even though the staged engine checkout is complete.
  if ! git -C "$checkout" cat-file -e "$RELEASE_REF^{commit}" 2>/dev/null; then
    git_with_token -C "$checkout" fetch --depth 1 origin "$RELEASE_REF" >&2 2>/dev/null \
      || git_with_token -C "$checkout" fetch origin >&2
  fi
  assert_no_token "$checkout" || exit 1
  git -C "$checkout" checkout --force "$RELEASE_REF" >&2
}
if [ "${1:-}" = "token-selftest" ]; then
  # The engine clone stores no credential: a fresh clone under a planted token, and an existing
  # checkout whose origin a previous version stored as `https://x-access-token:<token>@github.com/…`,
  # each end with no trace of either in .git/config; and the guard refuses a config that has one.
  st="$(mktemp -d)"; trap 'rm -rf "$st"' EXIT
  # A throwaway fixture repo: no host hook or signing applies to it.
  git init -q "$st/src" && git -C "$st/src" -c user.name=t -c user.email=t@t.invalid -c commit.gpgsign=false \
    -c core.hooksPath=/dev/null commit -q --allow-empty -m pin && ref="$(git -C "$st/src" rev-parse HEAD)" \
    || { echo "oracle token-selftest: could not build the fixture repo"; exit 1; }
  fail=0
  ( export BUSBAR_RELEASE_TOKEN=plant-token-0123456789 RELEASE_REPO="file://$st/src" RELEASE_REF="$ref"
    clone_engine "$st/fresh" ) >/dev/null 2>&1 || { echo "  [FAILED] the fresh clone failed"; fail=1; }
  if [ ! -f "$st/fresh/.git/config" ] || grep -qE 'plant-token|x-access-token|extraheader' "$st/fresh/.git/config"; then
    echo "  [FAILED] a fresh clone stored the token"; fail=1
  else echo "  [ok]     a fresh clone under a token stores none"; fi
  git -C "$st/fresh" remote set-url origin "https://x-access-token:plant-token-0123456789@github.com/GetBusbar/busbar-release.git"
  if ( export BUSBAR_RELEASE_TOKEN=plant-token-0123456789; assert_no_token "$st/fresh" ) 2>/dev/null; then
    echo "  [FAILED] the guard passed a config holding the token"; fail=1
  else echo "  [ok]     the guard refuses a config holding a token"; fi
  ( export BUSBAR_RELEASE_TOKEN=plant-token-0123456789 RELEASE_REPO="file://$st/src" RELEASE_REF="$ref"
    clone_engine "$st/fresh" ) >/dev/null 2>&1 || { echo "  [FAILED] re-using the stale checkout failed"; fail=1; }
  if grep -qE 'plant-token|x-access-token' "$st/fresh/.git/config"; then
    echo "  [FAILED] a stale tokenized origin survived a run"; fail=1
  else echo "  [ok]     a stale tokenized origin is scrubbed"; fi
  # A checkout that already holds the pin is reused offline: with an unreachable origin, no fetch is
  # attempted. Judged on git's own stderr, not the exit status: errexit is off inside a `&&`/`||`
  # list, so a failed fetch there would not end the function, while on a tokenless runner it does.
  ( export BUSBAR_RELEASE_TOKEN=plant-token-0123456789 RELEASE_REPO="file://$st/no-such-repo" RELEASE_REF="$ref"
    clone_engine "$st/fresh" ) >/dev/null 2>"$st/offline.err" || true
  if grep -qiE "fatal|error|does not appear|could not read" "$st/offline.err"; then
    echo "  [FAILED] a checkout holding the pin still fetched: $(head -1 "$st/offline.err")"; fail=1
  else echo "  [ok]     a checkout holding the pin is reused without a fetch"; fi
  if grep -qE 'plant-token|x-access-token|extraheader' "$st/fresh/.git/config"; then
    echo "  [FAILED] the offline reuse stored the token"; fail=1
  fi
  # A CI RUN READS NO TOKEN: under each CI marker, with every token name set, git is handed no
  # credential header and release_token yields nothing; with none, a local run's token is used.
  hdr() { git_with_token -C "$st/src" config --get "http.https://github.com/.extraheader" 2>/dev/null || true; }
  for marker in MODERNCI=1 MODERNCI_JOB=oracle MODERNCI_TO_SHA="$ref" MODERNCI_HEAD="$ref" MODERNCI_COMMIT="$ref" \
      BUSBAR_ORACLE_JUDGE_PATH=/nonexistent CI=true; do
    # The subshell is the point: each marker and token lives only there. ("$marker" is NAME=value.)
    # shellcheck disable=SC2163,SC2030
    got="$( unset MODERNCI MODERNCI_JOB MODERNCI_TO_SHA MODERNCI_HEAD MODERNCI_COMMIT BUSBAR_ORACLE_JUDGE_PATH CI
      export "$marker" BUSBAR_RELEASE_TOKEN=plant-token-0123456789 GH_TOKEN=plant-token-0123456789 GITHUB_TOKEN=plant-token-0123456789
      hdr; release_token || true )"
    if [ -n "$got" ]; then echo "  [FAILED] under ${marker%%=*} a token was read (git got a credential header)"; fail=1
    else echo "  [ok]     under ${marker%%=*} no token is read, every token name set"; fi
  done
  # shellcheck disable=SC2030,SC2031
  got="$( unset MODERNCI MODERNCI_JOB MODERNCI_TO_SHA MODERNCI_HEAD MODERNCI_COMMIT BUSBAR_ORACLE_JUDGE_PATH CI
    export GH_TOKEN=plant-token-0123456789; hdr )"
  if [ -n "$got" ]; then echo "  [ok]     GREEN twin: a local run (no CI marker) still hands git its token"
  else echo "  [FAILED] a local run's token was not used: the CI rows above prove nothing"; fail=1; fi
  [ "$fail" = 0 ] && { echo "oracle token-selftest: the engine clone stores no credential; a CI run reads no token"; exit 0; }
  echo "oracle token-selftest: FAILED"; exit 1
fi
# ── the pinned judge, FETCHED (OWNER 2026-10-13: no hand-installed tools; ModernCI installs no judge) ──
# On Linux the judge is the binary busbar-release's dev-bin.yml built and published from the pinned
# commit: `busbar-oracle-linux-<arch>-<release_ref>` on the `dev-bin` release, run only when its
# sha256 is the pin's `sha256_linux_<arch>` line. UNDER MODERNCI the pin is ModernCI's protected
# config's, never a file the candidate wrote (judge_pin_text below): BUSBAR_ORACLE_RELEASE_REPO,
# BUSBAR_ORACLE_RELEASE_REF, BUSBAR_ORACLE_SHA256_LINUX_{X86_64,AARCH64}, BUSBAR_ORACLE_CRATE and
# BUSBAR_ORACLE_BIN, any one missing is NO JUDGE. No file in the tree restates them, so a repin is one
# branch-file change and a candidate never names its own judge. A pin with no line for this host's
# architecture has NO JUDGE (red, never another architecture's, never a source build). A `.sig` beside
# the asset is verified against busbar-release's release key (Ed25519 over "<asset name>\n<sha256>\n",
# busbar-release-cli update.rs RELEASE_KEY_SPKI) before the bytes are ever made executable; a
# `.sha256` beside it must agree with the pin. The verified binary is cached by its sha256 and
# re-hashed on every use, so a cache cannot substitute a judge. The token (BUSBAR_RELEASE_TOKEN, else
# GH_TOKEN, else GITHUB_TOKEN; a LOCAL run only, release_token) reaches curl on stdin as a config line:
# never on an argv, never on disk. A CI run never fetches: NO JUDGE without ModernCI's judge path.
ORACLE_RELEASE_API="https://api.github.com/repos/GetBusbar/busbar-release"
# THE TRUSTED RELEASE KEYS a judge's .sig may verify with (busbar-release-cli update.rs RELEASE_KEYS,
# same keys, same order): busbar-release-2026-10-28, the owner's key that signs every judge from
# 2026-10-28 (its private half is ModernCI's BUSBAR_RELEASE_SIGNING_KEY), then busbar-release-2026-10-09,
# the earlier key, kept so what it already signed still verifies (nobody holds its private half).
ORACLE_RELEASE_KEY_PEMS=(
'-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAHC1U0BcT6iFe98mWXNriKeDNxO6xOaoMY5UXotNweEs=
-----END PUBLIC KEY-----'
'-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAT8gl0GhaEpxYXdRqfeNZ6KU8KgmI+8qbtP8UZPNPJiU=
-----END PUBLIC KEY-----'
)
_pin_in() { awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,"");print;exit}'; }
sha256_of() {  # sha256_of <file> — the hex digest, or nothing
  if command -v sha256sum >/dev/null 2>&1; then sha256sum -- "$1" | cut -c1-64
  else shasum -a 256 -- "$1" | cut -c1-64; fi
}
judge_arch() { local a; a="$(uname -m)"; [ "$a" = arm64 ] && a=aarch64; printf '%s' "$a"; }
# judge_env — the environment a cached judge was fetched on, and the only one it is reused on: the
# OS, the architecture and the C library (glibc major.minor, or musl). A judge cached on one host's
# glibc is never handed to another's (a GLIBC_2.39 binary from one environment refused to start on
# another, ModernCI #1827). ORACLE_JUDGE_LIBC overrides the C library word (the selftest's plant).
judge_libc() {
  if [ -n "${ORACLE_JUDGE_LIBC:-}" ]; then printf '%s' "$ORACLE_JUDGE_LIBC"; return; fi
  local v
  v="$(ldd --version 2>&1 | head -n1)"
  case "$v" in
    *musl*) printf 'musl' ;;
    *) v="$(printf '%s' "$v" | grep -oE '[0-9]+\.[0-9]+$')"; printf 'glibc%s' "${v:-unknown}" ;;
  esac
}
judge_env() { printf '%s-%s-%s' "$(uname -s | tr '[:upper:]' '[:lower:]')" "$(judge_arch)" "$(judge_libc)"; }
# judge_starts <bin> — the judge runs here (its --help answers: busbar-oracle's CLI states no
# --version, and --help is clap's own); a binary that cannot start on this host (a C library it
# does not have) is not a judge for it.
judge_starts() { "$1" --help >/dev/null 2>&1; }
# token_word — which token the release API is read with, never its value.
token_word() {
  if ci_run; then printf 'a CI run reads no token (BUSBAR_RELEASE_TOKEN, GH_TOKEN and GITHUB_TOKEN are never read)'; return; fi
  if [ -n "${BUSBAR_RELEASE_TOKEN:-}" ]; then printf 'BUSBAR_RELEASE_TOKEN present'
  elif [ -n "${GH_TOKEN:-}" ]; then printf 'BUSBAR_RELEASE_TOKEN absent, GH_TOKEN present'
  elif [ -n "${GITHUB_TOKEN:-}" ]; then printf 'BUSBAR_RELEASE_TOKEN absent, GITHUB_TOKEN present'
  else printf 'no token (BUSBAR_RELEASE_TOKEN, GH_TOKEN and GITHUB_TOKEN are all absent)'; fi
}
# ── UNDER MODERNCI THE JUDGE AND THE GOLDEN ARE THE CONFIG'S, NEVER THE CANDIDATE'S ─────────────
# ModernCI's protected config (which a candidate cannot change without a person) names the judge
# (BUSBAR_ORACLE_RELEASE_REPO / _REF / _SHA256_LINUX_X86_64 / _SHA256_LINUX_AARCH64 / _CRATE / _BIN) and the 1.5.5
# golden (BUSBAR_GOLDEN_1_5_5_TREE, a git tree id). The judge is fetched by the env's values only;
# the golden is read from the object database by that tree id only, never from the worktree. The
# candidate's pin and its golden/1.5.5 tree must EQUAL them: a mismatch is red naming both values.
ORACLE_GOLDEN_REL="testing/shadow-oracle/golden/1.5.5"
ORACLE_ENV_KEYS="BUSBAR_ORACLE_RELEASE_REPO=release_repo BUSBAR_ORACLE_RELEASE_REF=release_ref BUSBAR_ORACLE_SHA256_LINUX_X86_64=sha256_linux_x86_64 BUSBAR_ORACLE_SHA256_LINUX_AARCH64=sha256_linux_aarch64 BUSBAR_ORACLE_CRATE=crate BUSBAR_ORACLE_BIN=bin"
# BUSBAR_ORACLE_JUDGE_PATH is a ModernCI marker too: only ModernCI hands it over (see resolve_bin).
under_modernci() { [ -n "${BUSBAR_ORACLE_JUDGE_PATH:-}${MODERNCI:-}${MODERNCI_JOB:-}${MODERNCI_TO_SHA:-}${MODERNCI_HEAD:-}${MODERNCI_COMMIT:-}" ]; }
# in_ci — any CI run: a ModernCI marker or a generic CI=. No CI run takes BUSBAR_ORACLE_RUST_BIN.
in_ci() { ci_run; }
# THE CANDIDATE is the tree $BUSBAR_ORACLE_DATA names (else this shim's own checkout): ModernCI may run
# the TARGET's copy of this shim with DATA pointing into the candidate's tree. Its pin and golden are
# the ones held to the config.
cand_data() { printf '%s\n' "${BUSBAR_ORACLE_DATA:-$here/testing/shadow-oracle}"; }
cand_root() { git -C "$(cand_data)" rev-parse --show-toplevel 2>/dev/null; }
env_judge_pin() {  # env_judge_pin — the branch file's judge pin text; NO JUDGE when any key is unset
  local pair var missing=""
  for pair in $ORACLE_ENV_KEYS; do
    var="${pair%%=*}"
    [ -n "${!var:-}" ] || missing="$missing $var"
  done
  if [ -n "$missing" ]; then
    echo "oracle: NO JUDGE: the environment sets no$missing. The judge is named by the branch file's env only (busbar modernci-config .ci/*.yaml). Refusing." >&2
    return 1
  fi
  for pair in $ORACLE_ENV_KEYS; do
    var="${pair%%=*}"; printf '%s=%s\n' "${pair#*=}" "${!var}"
  done
}
judge_pin_text() {  # judge_pin_text — the judge's pin text, from the branch file's env only
  env_judge_pin
}
# modernci_golden — under ModernCI, every `--golden` in the global `args` becomes
# BUSBAR_GOLDEN_1_5_5_TREE read from the candidate's object database (odb_golden); 1 when none can be.
modernci_golden() {
  local root gdir i
  root="$(cand_root)" || { echo "oracle: NO GOLDEN: the candidate's data dir $(cand_data) is in no git checkout. Refusing." >&2; return 1; }
  mkdir -p "$cache_home"
  gdir="$(mktemp -d "${cache_home%/}/oracle-golden-odb.XXXXXX")"
  odb_golden "$root" "$gdir" || return 1
  for i in "${!args[@]}"; do
    if [ "${args[$i]}" = --golden ]; then args[$((i+1))]="$gdir"; fi
    case "${args[$i]}" in --golden=*) args[$i]="--golden=$gdir";; esac
  done
  echo "oracle: the 1.5.5 golden is tree $BUSBAR_GOLDEN_1_5_5_TREE, read from the object database (never the worktree)" >&2
}
odb_golden() {  # odb_golden <repo> <out dir> — BUSBAR_GOLDEN_1_5_5_TREE, from the object database, into <out dir>; else 1
  local repo="$1" out="$2" want="${BUSBAR_GOLDEN_1_5_5_TREE:-}" got
  if ! [[ "$want" =~ ^[0-9a-f]{40}$ ]]; then
    echo "oracle: NO GOLDEN: ModernCI's config names no 40-hex BUSBAR_GOLDEN_1_5_5_TREE ('${want:-unset}'). Refusing." >&2
    return 1
  fi
  if [ "$(git -C "$repo" cat-file -t "$want" 2>/dev/null)" != tree ]; then
    echo "oracle: NO GOLDEN: BUSBAR_GOLDEN_1_5_5_TREE $want is not a tree in this checkout's object database. Refusing." >&2
    return 1
  fi
  got="$(git -C "$repo" rev-parse -q --verify "HEAD:$ORACLE_GOLDEN_REL" 2>/dev/null)" || got="<none>"
  if [ "$got" != "$want" ]; then
    echo "oracle: the candidate's $ORACLE_GOLDEN_REL is tree $got, ModernCI's BUSBAR_GOLDEN_1_5_5_TREE is $want (a golden change is a config change). Refusing." >&2
    return 1
  fi
  rm -rf "$out" && mkdir -p "$out" && git -C "$repo" archive --format=tar "$want" | tar -xf - -C "$out"
}
release_api() {  # release_api <url> [<accept> [<out> [<what>]]] — an authenticated GET; the token never on an argv
  local tok
  if ci_run; then
    echo "oracle: NO JUDGE: a CI run never reads busbar-release's dev-bin release: the judge is ModernCI's \$BUSBAR_ORACLE_JUDGE_PATH, fetched outside the run from its tool pin ($(token_word))" >&2
    return 1
  fi
  tok="$(release_token)" || { echo "oracle: no token to read busbar-release's dev-bin release ($(token_word))" >&2; return 1; }
  local accept="${2:-application/vnd.github+json}" out="${3:-}" what="${4:-$1}" body code
  body="$(mktemp)"
  code="$(printf 'header = "Authorization: Bearer %s"\n' "$tok" \
    | curl -sSL --retry 3 -K - -H "Accept: $accept" -o "$body" -w '%{http_code}' "$1")" || code="${code:-000}"
  if [ "$code" != 200 ]; then
    case "$code" in
      403) echo "oracle: busbar-release answered 403 (forbidden) for $what: the token cannot read it ($(token_word))" >&2 ;;
      404) echo "oracle: busbar-release answered 404 (not found) for $what: not published, or the token cannot see it ($(token_word))" >&2 ;;
      *) echo "oracle: busbar-release answered HTTP $code for $what ($(token_word))" >&2 ;;
    esac
    rm -f "$body"; return 1
  fi
  if [ -n "$out" ]; then mv -f "$body" "$out"; else cat "$body"; rm -f "$body"; fi
}
judge_assets() {  # judge_assets <out tsv> — every dev-bin asset as `<id>\t<name>`
  local out="$1" rid page n
  rid="$(release_api "$ORACLE_RELEASE_API/releases/tags/dev-bin" | jq -r '.id')" || return 1
  [[ "$rid" =~ ^[0-9]+$ ]] || { echo "oracle: busbar-release has no dev-bin release" >&2; return 1; }
  : >"$out"
  for page in $(seq 1 20); do
    n="$(release_api "$ORACLE_RELEASE_API/releases/$rid/assets?per_page=100&page=$page" \
      | jq -r '.[] | "\(.id)\t\(.name)"' | tee -a "$out" | wc -l)" || return 1
    [ "$n" -lt 100 ] && break
  done
  return 0
}
fetch_asset() {  # fetch_asset <source> <name> <out> — <source>: a directory (the selftest) or an asset list
  local src="$1" name="$2" out="$3" id
  if [ -d "$src" ]; then [ -f "$src/$name" ] && cp "$src/$name" "$out"; return; fi
  id="$(awk -F'\t' -v n="$name" '$2==n{print $1; exit}' "$src")"
  [ -n "$id" ] || return 1
  release_api "$ORACLE_RELEASE_API/releases/assets/$id" application/octet-stream "$out" "the asset $name"
}
verify_judge_sig() {  # verify_judge_sig <asset name> <sha256> <sig file (base64)> <pubkey pem>... — any key verifies
  local name="$1" hex="$2" sig="$3" d pem n=0 rc=1
  shift 3
  command -v openssl >/dev/null 2>&1 || { echo "oracle: refusing the judge: $name has a .sig and there is no openssl to verify it" >&2; return 1; }
  d="$(mktemp -d)"
  printf '%s\n%s\n' "$name" "$hex" >"$d/msg"
  if tr -d '\n\r ' <"$sig" | base64 -d >"$d/sig" 2>/dev/null; then
    for pem in "$@"; do
      n=$((n + 1))
      printf '%s\n' "$pem" >"$d/key$n.pem"
      if openssl pkeyutl -verify -pubin -inkey "$d/key$n.pem" -rawin -in "$d/msg" -sigfile "$d/sig" >/dev/null 2>&1; then rc=0; break; fi
    done
  fi
  rm -rf "$d"
  [ "$rc" = 0 ] || echo "oracle: refusing the judge: $name's .sig is not a signature of it by any of busbar-release's $# trusted release key(s)" >&2
  return "$rc"
}
fetch_judge() {  # fetch_judge <pin text> <cache dir> <source|api> [<pubkey pem>] — prints the verified judge
  local text="$1" cache="$2" src="$3" arch ref want name bin tmp got side keys
  if [ -n "${4:-}" ]; then keys=("$4"); else keys=("${ORACLE_RELEASE_KEY_PEMS[@]}"); fi
  arch="$(judge_arch)"
  ref="$(printf '%s\n' "$text" | _pin_in release_ref)"
  want="$(printf '%s\n' "$text" | _pin_in "sha256_linux_$arch")"
  [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || { echo "oracle: no judge: the pin names no full 40-hex release_ref" >&2; return 1; }
  [[ "$want" =~ ^[0-9a-f]{64}$ ]] || { echo "oracle: no judge: the pin has no sha256_linux_$arch line, and a host whose architecture the pin does not name has no judge" >&2; return 1; }
  name="busbar-oracle-linux-$arch-$ref"
  # Cached by its digest AND the environment it was fetched on (judge_env): never reused on another.
  bin="$cache/$want/$(judge_env)/busbar-oracle"
  if [ -x "$bin" ] && [ "$(sha256_of "$bin")" = "$want" ]; then
    if judge_starts "$bin"; then printf '%s\n' "$bin"; return 0; fi
    echo "oracle: the cached judge $bin does not start here; deleting it and fetching again" >&2
    rm -f "$bin"
  fi
  tmp="$(mktemp -d)"
  [ "$src" = api ] && echo "oracle: fetching the judge $name from busbar-release's dev-bin release ($(token_word))" >&2
  if [ "$src" = api ]; then judge_assets "$tmp/assets.tsv" || { rm -rf "$tmp"; return 1; }; src="$tmp/assets.tsv"; fi
  fetch_asset "$src" "$name" "$tmp/$name" || { echo "oracle: no judge: $name is not on busbar-release's dev-bin release" >&2; rm -rf "$tmp"; return 1; }
  got="$(sha256_of "$tmp/$name")"
  [ "$got" = "$want" ] || { echo "oracle: refusing the judge: $name has sha256 $got, the pin says $want" >&2; rm -rf "$tmp"; return 1; }
  if fetch_asset "$src" "$name.sha256" "$tmp/$name.sha256" 2>/dev/null; then
    side="$(cut -c1-64 <"$tmp/$name.sha256")"
    [ "$side" = "$want" ] || { echo "oracle: refusing the judge: its published .sha256 ($side) is not the pin's $want" >&2; rm -rf "$tmp"; return 1; }
  fi
  if fetch_asset "$src" "$name.sig" "$tmp/$name.sig" 2>/dev/null; then
    verify_judge_sig "$name" "$got" "$tmp/$name.sig" "${keys[@]}" || { rm -rf "$tmp"; return 1; }
  fi
  mkdir -p "$(dirname "$bin")"
  mv "$tmp/$name" "$bin.part" && chmod +x "$bin.part" && mv -f "$bin.part" "$bin"
  rm -rf "$tmp"
  if ! judge_starts "$bin"; then
    echo "oracle: no judge: the fetched $name does not start on this host ($(judge_env)): $("$bin" --help 2>&1 | head -n 3)" >&2
    rm -f "$bin"; return 1
  fi
  printf '%s\n' "$bin"
}
if [ "${1:-}" = "fetch-selftest" ]; then
  # RED-before-green for the fetched judge, offline: a fixture "release" directory stands in for the
  # dev-bin API (fetch_asset's directory source), and a throwaway Ed25519 key for busbar-release's.
  st="$(mktemp -d)"; trap 'rm -rf "$st"' EXIT
  fail=0 arch="$(judge_arch)" ref="0123456789abcdef0123456789abcdef01234567"
  name="busbar-oracle-linux-$arch-$ref"
  mkdir -p "$st/rel" "$st/cache"
  printf '#!/bin/sh\necho planted-judge\n' >"$st/rel/$name"
  good="$(sha256_of "$st/rel/$name")"
  pin_ok="release_ref=$ref
sha256_linux_$arch=$good"
  if p="$(fetch_judge "$pin_ok" "$st/cache" "$st/rel" 2>/dev/null)" && [ "$("$p")" = planted-judge ]; then
    echo "  [ok]     the pinned digest's judge is fetched, cached and runs"
  else echo "  [FAILED] the pinned digest's judge was not fetched"; fail=1; fi
  rm -f "$st/rel/$name"
  if p="$(fetch_judge "$pin_ok" "$st/cache" "$st/rel" 2>/dev/null)" && [ "$("$p")" = planted-judge ]; then
    echo "  [ok]     a cached judge is reused by its digest, with no source"
  else echo "  [FAILED] the cached judge was not reused"; fail=1; fi
  # THE CACHE IS KEYED BY THE ENVIRONMENT (ModernCI #1827): a judge cached on one C library is
  # never handed to a host with another, and the same environment reuses it.
  printf '#!/bin/sh\necho planted-judge\n' >"$st/rel/$name"
  if ORACLE_JUDGE_LIBC=glibc2.35 fetch_judge "$pin_ok" "$st/cachek" "$st/rel" >/dev/null 2>&1; then
    rm -f "$st/rel/$name"
    if ORACLE_JUDGE_LIBC=glibc2.39 fetch_judge "$pin_ok" "$st/cachek" "$st/rel" >/dev/null 2>&1; then
      echo "  [FAILED] a judge cached on glibc2.35 was handed to a glibc2.39 host"; fail=1
    else echo "  [ok]     a judge cached on another C library is not reused"; fi
    if p="$(ORACLE_JUDGE_LIBC=glibc2.35 fetch_judge "$pin_ok" "$st/cachek" "$st/rel" 2>/dev/null)" && [ "$("$p")" = planted-judge ]; then
      echo "  [ok]     the same environment reuses its cached judge"
    else echo "  [FAILED] the same environment did not reuse its cached judge"; fail=1; fi
  else echo "  [FAILED] the keyed fixture judge was not fetched"; fail=1; fi
  # A JUDGE THAT DOES NOT START is no judge: fetched, it refuses; cached, it is deleted and fetched
  # again (and refuses the same way when the source holds the same bytes).
  printf '#!/bin/sh\n[ "$1" = --help ] && exit 127\necho dead-judge\n' >"$st/rel/$name"
  dead="$(sha256_of "$st/rel/$name")"
  pin_dead="release_ref=$ref
sha256_linux_$arch=$dead"
  if fetch_judge "$pin_dead" "$st/cached" "$st/rel" >/dev/null 2>"$st/err"; then
    echo "  [FAILED] a judge that does not start was handed out"; fail=1
  elif grep -q "does not start" "$st/err"; then echo "  [ok]     a fetched judge that does not start refuses"
  else echo "  [FAILED] the dead-judge refusal did not say so: $(cat "$st/err")"; fail=1; fi
  kept="$st/cached/$dead/$(judge_env)/busbar-oracle"
  mkdir -p "$(dirname "$kept")" && cp "$st/rel/$name" "$kept" && chmod +x "$kept"
  if fetch_judge "$pin_dead" "$st/cached" "$st/rel" >/dev/null 2>"$st/err"; then
    echo "  [FAILED] a cached judge that does not start was handed out"; fail=1
  elif grep -q "deleting it" "$st/err" && [ ! -e "$kept" ]; then
    echo "  [ok]     a cached judge that does not start is deleted, never reused"
  else echo "  [FAILED] the dead cached judge was not deleted: $(cat "$st/err")"; fail=1; fi
  printf '#!/bin/sh\necho planted-judge\n' >"$st/rel/$name"
  pin_wrong="release_ref=$ref
sha256_linux_$arch=$(printf 'f%.0s' $(seq 1 64))"
  if fetch_judge "$pin_wrong" "$st/cache2" "$st/rel" >/dev/null 2>"$st/err"; then
    echo "  [FAILED] a judge whose sha256 is not the pin's ran"; fail=1
  elif grep -q "refusing the judge" "$st/err"; then echo "  [ok]     a wrong sha256 refuses the judge"
  else echo "  [FAILED] the wrong-sha refusal did not say so: $(cat "$st/err")"; fail=1; fi
  if fetch_judge "release_ref=$ref" "$st/cache3" "$st/rel" >/dev/null 2>"$st/err"; then
    echo "  [FAILED] a pin with no line for this architecture produced a judge"; fail=1
  elif grep -q "no judge" "$st/err"; then echo "  [ok]     a pin with no sha256_linux_$arch line has no judge"
  else echo "  [FAILED] the missing-line refusal did not say \"no judge\": $(cat "$st/err")"; fail=1; fi
  printf 'e%.0s' $(seq 1 64) >"$st/rel/$name.sha256"
  if fetch_judge "$pin_ok" "$st/cache4" "$st/rel" >/dev/null 2>/dev/null; then
    echo "  [FAILED] a published .sha256 disagreeing with the pin was accepted"; fail=1
  else echo "  [ok]     a published .sha256 disagreeing with the pin refuses"; fi
  printf '%s  %s\n' "$good" "$name" >"$st/rel/$name.sha256"
  if command -v openssl >/dev/null 2>&1 && openssl genpkey -algorithm ed25519 -out "$st/k.pem" 2>/dev/null \
     && openssl pkey -in "$st/k.pem" -pubout -out "$st/pub.pem" 2>/dev/null; then
    printf '%s\n%s\n' "$name" "$good" >"$st/msg"
    openssl pkeyutl -sign -inkey "$st/k.pem" -rawin -in "$st/msg" -out "$st/sig.bin" 2>/dev/null
    base64 <"$st/sig.bin" | tr -d '\n' >"$st/rel/$name.sig"
    if fetch_judge "$pin_ok" "$st/cache5" "$st/rel" "$(cat "$st/pub.pem")" >/dev/null 2>&1; then
      echo "  [ok]     a .sig made by the release key is accepted"
    else echo "  [FAILED] a good .sig was refused"; fail=1; fi
    if fetch_judge "$pin_ok" "$st/cache6" "$st/rel" >/dev/null 2>"$st/err"; then
      echo "  [FAILED] a .sig made by another key was accepted under busbar-release's key"; fail=1
    elif grep -q "release key" "$st/err"; then echo "  [ok]     a .sig made by another key refuses"
    else echo "  [FAILED] the bad-.sig refusal did not say so: $(cat "$st/err")"; fail=1; fi
  else echo "  [FAILED] no openssl with Ed25519 here: the .sig check cannot be proven"; fail=1; fi
  # Where the pin comes from under ModernCI is base-selftest's.
  [ "$fail" = 0 ] && { echo "oracle fetch-selftest: the judge is the pinned digest's, or there is none"; exit 0; }
  echo "oracle fetch-selftest: FAILED"; exit 1
fi
# release-key-selftest: the judge's .sig is checked against busbar-release's TRUSTED release keys
# (busbar-release-cli update.rs RELEASE_KEYS, same keys, same order): the owner's 2026-10-28 key,
# which signs, and the earlier key, kept so what it already signed still verifies. A .sig by a listed
# key verifies; one by any other key is refused.
if [ "${1:-}" = "release-key-selftest" ]; then
  st="$(mktemp -d)"; trap 'rm -rf "$st"' EXIT; fail=0
  ok() { echo "  [ok]     $1"; }; bad() { echo "  [FAILED] $1"; fail=1; }
  new='MCowBQYDK2VwAyEAHC1U0BcT6iFe98mWXNriKeDNxO6xOaoMY5UXotNweEs='
  old='MCowBQYDK2VwAyEAT8gl0GhaEpxYXdRqfeNZ6KU8KgmI+8qbtP8UZPNPJiU='
  case "${ORACLE_RELEASE_KEY_PEMS[0]:-}" in *"$new"*) ok "the owner's 2026-10-28 key is trusted, and first (it signs)" ;; *) bad "the owner's 2026-10-28 key is not the first trusted key" ;; esac
  case "${ORACLE_RELEASE_KEY_PEMS[*]:-}" in *"$old"*) ok "the earlier key stays trusted (what it signed still verifies)" ;; *) bad "the earlier key is not trusted" ;; esac
  if command -v openssl >/dev/null 2>&1 \
     && openssl genpkey -algorithm ed25519 -out "$st/a.pem" 2>/dev/null && openssl pkey -in "$st/a.pem" -pubout -out "$st/a.pub" 2>/dev/null \
     && openssl genpkey -algorithm ed25519 -out "$st/u.pem" 2>/dev/null && openssl pkey -in "$st/u.pem" -pubout -out "$st/u.pub" 2>/dev/null; then
    name="busbar-oracle-linux-aarch64-$(printf 'a%.0s' $(seq 1 40))"; hex="$(printf 'b%.0s' $(seq 1 64))"
    printf '%s\n%s\n' "$name" "$hex" >"$st/msg"
    for k in a u; do
      openssl pkeyutl -sign -inkey "$st/$k.pem" -rawin -in "$st/msg" -out "$st/$k.bin" 2>/dev/null
      base64 <"$st/$k.bin" | tr -d '\n' >"$st/$k.sig"
    done
    if verify_judge_sig "$name" "$hex" "$st/a.sig" "$(cat "$st/u.pub")" "$(cat "$st/a.pub")" 2>/dev/null; then
      ok "a .sig by the second listed key verifies"
    else bad "a .sig by a listed key was refused"; fi
    if verify_judge_sig "$name" "$hex" "$st/u.sig" "$(cat "$st/a.pub")" 2>/dev/null; then
      bad "a .sig by a key not on the list verified"
    else ok "a .sig by a key not on the list is refused"; fi
    if verify_judge_sig "$name" "$hex" "$st/u.sig" "${ORACLE_RELEASE_KEY_PEMS[@]}" 2>/dev/null; then
      bad "busbar-release's trusted keys accepted a .sig by an unknown key"
    else ok "busbar-release's trusted keys refuse a .sig by an unknown key"; fi
    if verify_judge_sig "$name" "$hex" "$st/a.sig" 2>/dev/null; then
      bad "a .sig verified against no key at all"
    else ok "no trusted key verifies nothing"; fi
  else bad "no openssl with Ed25519 here: the .sig check cannot be proven"; fi
  [ "$fail" = 0 ] && { echo "oracle release-key-selftest: the judge verifies with busbar-release's trusted keys and no other"; exit 0; }
  echo "oracle release-key-selftest: FAILED"; exit 1
fi
# `judge-pin`: the pin text the judge would be fetched by, or the refusal.
if [ "${1:-}" = "judge-pin" ]; then rc=0; judge_pin_text "$here" || rc=$?; exit "$rc"; fi
if [ "${1:-}" = "ci-token-selftest" ]; then
  # A CI RUN READS NO TOKEN (OWNER 2026-10-26, "cut it"), end to end. The shim under test runs in a
  # scratch checkout with the branch file's judge env set and EVERY token name planted; the release
  # API (curl) and git are logging fakes and `uname -s` answers $FAKE_OS. The GREEN twin, a local run
  # (no CI marker), still hands git its token, so the CI rows prove the rule and not a broken fake.
  # (These rows rode in base-selftest until the judge was named by the env alone and it went.) An
  # optional argument names the shim under test (for the red proof).
  under="${2:-$here/bin/oracle}"
  st="$(mktemp -d)"; trap 'rm -rf "$st"' EXIT
  fail=0
  NOSHA="$(printf 'f%.0s' $(seq 1 64))"
  CFG=(BUSBAR_ORACLE_RELEASE_REPO=https://github.com/GetBusbar/busbar-release.git
       BUSBAR_ORACLE_RELEASE_REF=151ad095a21819dca97e8bdb3384c3c3eb2eb806
       BUSBAR_ORACLE_SHA256_LINUX_X86_64="$NOSHA" BUSBAR_ORACLE_SHA256_LINUX_AARCH64="$NOSHA"
       BUSBAR_ORACLE_CRATE=busbar-release-oracle BUSBAR_ORACLE_BIN=busbar-oracle)
  TOKS=(BUSBAR_RELEASE_TOKEN=plant-token-0123456789 GH_TOKEN=plant-token-0123456789 GITHUB_TOKEN=plant-token-0123456789)
  # fakes on PATH: uname -s answers $FAKE_OS (uname -m is the host's); curl logs, keeps any config it
  # is handed on stdin (-K -: where a token would ride) and fails (no fetch); git logs whether it was
  # handed a credential header (GIT_CONFIG_KEY_0) and never clones (no network).
  mkdir -p "$st/fakebin"
  printf '#!/bin/sh\nif [ "$1" = -s ]; then echo "$FAKE_OS"; else exec %s "$@"; fi\n' "$(command -v uname)" >"$st/fakebin/uname"
  printf '#!/bin/sh\necho "curl $*" >>"%s/curl"\ncase "$*" in *"-K -"*) cat >>"%s/curl.stdin";; esac\nexit 22\n' "$st" "$st" >"$st/fakebin/curl"
  printf '#!/bin/sh\n[ -n "${GIT_CONFIG_KEY_0:-}" ] && echo "git-credential $GIT_CONFIG_KEY_0" >>"%s/git"\ncase " $* " in *" clone "*) echo "git clone" >>"%s/git"; exit 128;; esac\nexec %s "$@"\n' "$st" "$st" "$(command -v git)" >"$st/fakebin/git"
  chmod +x "$st/fakebin/uname" "$st/fakebin/curl" "$st/fakebin/git"
  r="$st/repo"; git init -q "$r"; mkdir -p "$r/bin" "$r/testing/shadow-oracle"; cp "$under" "$r/bin/oracle"
  printf '{"cells": [{"id": "fam|a"}]}\n' >"$r/testing/shadow-oracle/cells.json"
  printf '{"accepted": []}\n' >"$r/testing/shadow-oracle/accepted-differences.json"
  shim() {  # shim <env...> -- <args...> — rc in $st/rc, stderr in $st/err; the fakes' logs emptied first
    local -a e=(); while [ "$1" != -- ]; do e+=("$1"); shift; done; shift
    : >"$st/curl"; : >"$st/curl.stdin"; : >"$st/git"; local rc=0
    ( cd "$r" && env -u MODERNCI -u MODERNCI_JOB -u MODERNCI_TO_SHA -u MODERNCI_HEAD -u MODERNCI_COMMIT \
        -u BUSBAR_ORACLE_JUDGE_PATH -u BUSBAR_ORACLE_RUST_BIN -u CI -u BUSBAR_RELEASE_TOKEN -u GH_TOKEN -u GITHUB_TOKEN \
        -u BUSBAR_ORACLE_RELEASE_REPO -u BUSBAR_ORACLE_RELEASE_REF -u BUSBAR_ORACLE_SHA256_LINUX_X86_64 \
        -u BUSBAR_ORACLE_SHA256_LINUX_AARCH64 -u BUSBAR_ORACLE_CRATE -u BUSBAR_ORACLE_BIN -u BUSBAR_GOLDEN_1_5_5_TREE -u BUSBAR_ORACLE_DATA \
        -u BUSBAR_ORACLE_PRODUCT_ROOT -u BUSBAR_ORACLE_TOOL_DIR -u BUSBAR_RELEASE_CHECKOUT -u MODERNCI_CACHE_DIR \
        PATH="$st/fakebin:$PATH" ${e[@]+"${e[@]}"} bash "$r/bin/oracle" "$@" ) >/dev/null 2>"$st/err" || rc=$?
    echo "$rc" >"$st/rc"
  }
  ok() { echo "  [ok]     $1"; }
  bad() { echo "  [FAILED] $1 (rc=$(cat "$st/rc"); $(head -c 400 "$st/err" | tr '\n' ' '))"; fail=1; }
  no_token_read() { [ ! -s "$st/curl" ] && ! grep -q plant-token "$st/curl.stdin"; }
  # (e) under ModernCI, the config's judge env, NO judge path handed over, on Linux: NO JUDGE naming
  # BUSBAR_ORACLE_JUDGE_PATH, nothing fetched, no token read.
  shim MODERNCI=1 "${CFG[@]}" "${TOKS[@]}" FAKE_OS=Linux -- --help
  { [ "$(cat "$st/rc")" != 0 ] && no_token_read \
      && grep -q "NO JUDGE: ModernCI handed over no BUSBAR_ORACLE_JUDGE_PATH" "$st/err"; } \
    && ok "(e) under ModernCI, the config's judge, no judge path, every token set: NO JUDGE, zero fetches, no token read" \
    || bad "(e) a ModernCI run without a judge path fetched the judge ($(wc -l <"$st/curl" | tr -d ' ') fetches)"
  # (f) a bare CI= run on Linux, every token set: the release API is never called, so no token is read.
  shim CI=true "${CFG[@]}" "${TOKS[@]}" FAKE_OS=Linux -- --help
  { [ "$(cat "$st/rc")" != 0 ] && no_token_read && grep -q "a CI run never reads busbar-release" "$st/err"; } \
    && ok "(f) a bare CI= run on Linux, every token set: NO JUDGE, the release API never called, no token read" \
    || bad "(f) a CI= run reached the release API ($(wc -l <"$st/curl" | tr -d ' ') fetches; token on curl's stdin: $(grep -c plant-token "$st/curl.stdin"))"
  # (g) a bare CI= run off Linux, every token set: the engine clone gets no credential header.
  shim CI=true "${CFG[@]}" "${TOKS[@]}" FAKE_OS=Darwin -- --help
  { grep -q "git clone" "$st/git" && ! grep -q git-credential "$st/git"; } \
    && ok "(g) a bare CI= run off Linux, every token set: the engine clone carries no credential" \
    || bad "(g) a CI= run handed git a credential ($(tr '\n' ';' <"$st/git"))"
  # GREEN twin of (g): a LOCAL run (no CI marker) still authenticates its engine clone with the token.
  shim "${CFG[@]}" "${TOKS[@]}" FAKE_OS=Darwin -- --help
  grep -q "git-credential" "$st/git" \
    && ok "(g) GREEN twin: a local run's engine clone still uses the token" \
    || bad "(g) twin: a local run's clone carried no credential ($(tr '\n' ';' <"$st/git"))"
  [ "$fail" = 0 ] && { echo "oracle ci-token-selftest: a CI run reads no token; a local run still may"; exit 0; }
  echo "oracle ci-token-selftest: FAILED"; exit 1
fi
resolve_bin() {
  # NO CI RUN TAKES BUSBAR_ORACLE_RUST_BIN: it names a binary the job's own environment chose, so in
  # CI (a ModernCI marker, BUSBAR_ORACLE_JUDGE_PATH, or CI=) it is ignored entirely, said on stderr.
  if [ -n "${BUSBAR_ORACLE_RUST_BIN:-}" ] && in_ci; then
    echo "oracle: ignoring BUSBAR_ORACLE_RUST_BIN ($BUSBAR_ORACLE_RUST_BIN): a CI run's judge is ModernCI's, never an operator's binary" >&2
  fi
  # UNDER MODERNCI the only judge is the config's: its pin is held to the candidate's first, on every
  # OS (every field must match; any config value absent is NO JUDGE). Then the judge is the file
  # ModernCI pre-fetched OUTSIDE the run with its own forge credential and handed over as
  # $BUSBAR_ORACLE_JUDGE_PATH (from its protected pin: busbar-release's dev-bin asset for
  # BUSBAR_ORACLE_RELEASE_REF, sha256 per architecture) -- no fetch, no network, no token read, so no
  # job that runs candidate code needs BUSBAR_RELEASE_TOKEN -- taken only at the config's
  # BUSBAR_ORACLE_SHA256_LINUX_<arch>, and re-verified before every exec (verify_judge_now). Without a
  # judge path, NO JUDGE. Never a fetch, never a source build, never another digest.
  if under_modernci; then
    local pin_text arch var want got
    pin_text="$(judge_pin_text "$here")" || exit 1
    arch="$(judge_arch)"; var="BUSBAR_ORACLE_SHA256_LINUX_$(printf '%s' "$arch" | tr '[:lower:]' '[:upper:]')"
    if [ -n "${BUSBAR_ORACLE_JUDGE_PATH:-}" ]; then
      want="${!var:-}"; got=""
      if [ -z "$want" ]; then
        echo "oracle: NO JUDGE: BUSBAR_ORACLE_JUDGE_PATH ($BUSBAR_ORACLE_JUDGE_PATH) is set but ModernCI's config sets no $var to verify it against. Refusing." >&2
        exit 1
      fi
      [ -f "$BUSBAR_ORACLE_JUDGE_PATH" ] && got="$(sha256_of "$BUSBAR_ORACLE_JUDGE_PATH" 2>/dev/null || true)"
      if [ "$got" != "$want" ]; then
        echo "oracle: NO JUDGE: BUSBAR_ORACLE_JUDGE_PATH ($BUSBAR_ORACLE_JUDGE_PATH) has sha256 '${got:-<unreadable>}', not ModernCI's $var ('$want'). Refusing." >&2
        exit 1
      fi
      if [ ! -x "$BUSBAR_ORACLE_JUDGE_PATH" ]; then
        echo "oracle: NO JUDGE: BUSBAR_ORACLE_JUDGE_PATH ($BUSBAR_ORACLE_JUDGE_PATH) is not executable. Refusing." >&2
        exit 1
      fi
      printf '%s\n' "$BUSBAR_ORACLE_JUDGE_PATH"; return 0
    fi
    # No judge path handed over: NO JUDGE, on every OS. A check never fetches the judge itself (that
    # took BUSBAR_RELEASE_TOKEN inside the run); ModernCI's tool pin is the only source.
    echo "oracle: NO JUDGE: ModernCI handed over no BUSBAR_ORACLE_JUDGE_PATH (its tool pin busbar-oracle-judge, .ci/oracle-judge.pin, fetched outside the run). A check never fetches the judge and never reads a token. Refusing." >&2
    exit 1
  fi
  if [ -n "${BUSBAR_ORACLE_RUST_BIN:-}" ] && ! in_ci; then
    [ -x "$BUSBAR_ORACLE_RUST_BIN" ] || { echo "oracle: BUSBAR_ORACLE_RUST_BIN is not executable: $BUSBAR_ORACLE_RUST_BIN" >&2; exit 1; }
    printf '%s\n' "$BUSBAR_ORACLE_RUST_BIN"; return 0
  fi
  if [ "$(uname -s)" = Linux ]; then
    local pin_text
    pin_text="$(judge_pin_text "$here")" || exit 1
    fetch_judge "$pin_text" "$cache_home/busbar-oracle-judge" api || exit 1
    return 0
  fi
  local built="$root/checkout/target/release/$BINNAME"
  if [ -x "$built" ]; then printf '%s\n' "$built"; return 0; fi
  local checkout
  if [ -n "${BUSBAR_RELEASE_CHECKOUT:-}" ]; then
    checkout="$BUSBAR_RELEASE_CHECKOUT"
  else
    # busbar-release is a PRIVATE first-party repo, so a plain `git clone https://…` of it fails
    # unauthenticated on CI (the default GITHUB_TOKEN is scoped to THIS repo, not the sibling).
    # A Latchkey runner (`latchkey run`) has no token and no credential helper, so this clone fails
    # there. Stage the engine instead: `git clone` busbar-release into an untracked `.release/`
    # beside the packed tree, check out $release_ref, and in the job
    # `export BUSBAR_RELEASE_CHECKOUT=$PWD/.release` (precedence 2 above; no token leaves the machine).
    checkout="$root/checkout"
    clone_engine "$checkout"
  fi
  # ASK CARGO WHERE IT PUT THE BINARY; never assume `<checkout>/target/release`. That assumption is
  # wrong whenever the caller has a target directory of its own — `CARGO_TARGET_DIR` in the
  # environment (a `cargo test` run launched under one exports it straight through to the test
  # process, which is how this shim is reached), `CARGO_BUILD_TARGET_DIR`, or a `[build] target-dir`
  # in any `.cargo/config.toml` above the checkout (the checkout lives UNDER this repo, so this
  # repo's own config is one of them). In every one of those cases cargo built the engine perfectly
  # and wrote it somewhere else, and the old hard-coded path turned that into
  # "build produced no busbar-oracle" — a green build reported as a missing judge.
  #
  # `--message-format=json-render-diagnostics` keeps human diagnostics on stderr exactly as before
  # and puts one `compiler-artifact` JSON line per artifact on stdout; the `--bin` target's line
  # carries `"executable":"<path>"` (other artifacts carry `"executable":null`, which has no quotes
  # and so cannot match). Cargo emits the artifact line on a FRESH build too, so the path is
  # available whether or not anything recompiled.
  local artifacts
  artifacts="$( cd "$checkout" && cargo build --locked --release -p "$CRATE" --bin "$BINNAME" --message-format=json-render-diagnostics )"
  built="$(printf '%s\n' "$artifacts" | sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -1)"
  # Fallback for an engine/cargo that emitted no artifact line at all: the historical path.
  [ -n "$built" ] || built="$checkout/target/release/$BINNAME"
  [ -x "$built" ] || { echo "oracle: build produced no $BINNAME (cargo reported ${built:-no executable}; checkout $checkout)" >&2; exit 1; }
  printf '%s\n' "$built"
}
RUST_BIN="$(resolve_bin)"
# THE JUDGE IS RE-VERIFIED BEFORE EVERY EXEC (under ModernCI, ModernCI's pre-fetched
# $BUSBAR_ORACLE_JUDGE_PATH included). The candidate's own code runs between
# the fetch and the judge's later runs (its cargo build shares MODERNCI_CACHE_DIR with the judge
# cache; the recorder runs its busbar), so a judge file verified once could be swapped before the next
# exec. Every run of the judge, from this shim or through BUSBAR_ORACLE_BIN / record.sh, first
# re-hashes the file against BUSBAR_ORACLE_SHA256_LINUX_<arch>; a mismatch is NO JUDGE.
judge_want() { local var="BUSBAR_ORACLE_SHA256_LINUX_$(judge_arch | tr '[:lower:]' '[:upper:]')"; printf '%s' "${!var:-}"; }
verify_judge_now() {
  under_modernci || return 0
  local want got var
  var="BUSBAR_ORACLE_SHA256_LINUX_$(judge_arch | tr '[:lower:]' '[:upper:]')"
  want="$(judge_want)"; got="$(sha256_of "$RUST_BIN" 2>/dev/null || true)"
  if [ -z "$want" ]; then
    echo "oracle: NO JUDGE: ModernCI's config sets no $var to verify the judge at $RUST_BIN against. Refusing." >&2
    exit 1
  fi
  if [ "$got" != "$want" ]; then
    echo "oracle: NO JUDGE: the judge at $RUST_BIN has sha256 '${got:-<unreadable>}' now, not ModernCI's $var ('$want'): it changed after it was obtained. Refusing." >&2
    exit 1
  fi
}
judge() { verify_judge_now; "$RUST_BIN" "$@"; }

# ── the shim tool-dir (record.sh -> native) ─────────────────────────────────────────────────────
# HarnessOracle drives `$BUSBAR_ORACLE_TOOL_DIR/record.sh --bin <candidate> --out <work>/candidate
# [--filter <F>]`. Translate that to the native Rust recorder, which writes `<work-dir>/candidate`,
# so the recording lands exactly where HarnessOracle then loads it.
mkdir -p "$shim_dir"
# JUDGE_ENTRY: what record.sh and the product scripts (BUSBAR_ORACLE_BIN) run. Under ModernCI a
# generated wrapper that re-hashes the judge before each exec; elsewhere the judge itself.
JUDGE_ENTRY="$RUST_BIN"
if under_modernci; then
  JUDGE_ENTRY="$shim_dir/judge-verified"
  cat >"$JUDGE_ENTRY" <<JV
#!/usr/bin/env bash
# GENERATED by bin/oracle: the judge, re-verified against ModernCI's digest before every exec.
want='$(judge_want)' bin='$RUST_BIN'
if command -v sha256sum >/dev/null 2>&1; then got="\$(sha256sum -- "\$bin" | cut -c1-64)"; else got="\$(shasum -a 256 -- "\$bin" | cut -c1-64)"; fi
[ -n "\$want" ] && [ "\$got" = "\$want" ] || { echo "oracle: NO JUDGE: the judge at \$bin has sha256 '\$got' now, not ModernCI's '\$want'. Refusing." >&2; exit 1; }
exec "\$bin" "\$@"
JV
  chmod +x "$JUDGE_ENTRY"
fi
cat >"$shim_dir/record.sh" <<SHIM
#!/usr/bin/env bash
# GENERATED by bin/oracle (Phase C) — forwards record.sh's contract to the native Rust recorder.
set -euo pipefail
BIN="" OUT="" FILTER="" PLANE="all"
while [ \$# -gt 0 ]; do case "\$1" in
  --bin) BIN="\$2"; shift 2;;
  --out) OUT="\$2"; shift 2;;
  --filter) FILTER="\$2"; shift 2;;
  --plane) PLANE="\$2"; shift 2;;
  --shared-state) shift;;
  *) shift;;
esac; done
[ -n "\$BIN" ] && [ -n "\$OUT" ] || { echo "record.sh(shim): need --bin and --out" >&2; exit 2; }
# A filtered recording carries the premise cells its forgivenesses probe (bin/oracle premise-filter).
[ -z "\$FILTER" ] || FILTER="\$("$here/bin/oracle" premise-filter "\$FILTER")"
# --out is passed through as --out-dir, so the recording lands where the caller asked rather than at
# <work>/candidate. HarnessOracle happens to name its --out "candidate", so the two used to agree by
# luck; any other caller silently got an empty --out and read it as a recording of nothing.
mkdir -p "\$OUT"; OUT="\$(cd "\$OUT" && pwd)"; WORK="\$(cd "\$(dirname "\$OUT")" && pwd)"
exec "$here/bin/oracle" private-tmp "$JUDGE_ENTRY" record --native \\
  --busbar-repo "\${BUSBAR_ORACLE_PRODUCT_ROOT:-$here}" \\
  --candidate-bin "\$BIN" \\
  --oracle-data "\${BUSBAR_ORACLE_DATA:-$here/testing/shadow-oracle}" \\
  --work-dir "\$WORK" \\
  --out-dir "\$OUT" \\
  --family "\$PLANE" \${FILTER:+--filter "\$FILTER"}
SHIM
chmod +x "$shim_dir/record.sh"
# oracle-config.sh, materialized FROM THE ENGINE (it is embedded there). Its `oracle_write_config`
# forwards to `busbar-oracle config`, so the config bytes have exactly one source — a shell copy that
# drifted from `config_emit.rs` would move a golden with nobody editing a golden.
judge tool-dir "$shim_dir" --materialize >/dev/null

# ── the tool-location + data contract (unchanged names) ─────────────────────────────────────────
# The source pin IS the harness's tool half: harness-rev folds this ref instead of the tool's files.
export BUSBAR_ORACLE_TOOL_DIGEST="rust:${RELEASE_REPO}@${RELEASE_REF}"
export BUSBAR_ORACLE_PRODUCT_ROOT="${BUSBAR_ORACLE_PRODUCT_ROOT:-$here}"
export BUSBAR_ORACLE_DATA="${BUSBAR_ORACLE_DATA:-$here/testing/shadow-oracle}"
# TOOL_DIR is the shim dir (record.sh -> native, plus the materialized oracle-config.sh).
export BUSBAR_ORACLE_TOOL_DIR="${BUSBAR_ORACLE_TOOL_DIR:-$shim_dir}"
# WHERE THE ENGINE IS. The product's script-driver cells resolve their leaf tools (mock / capture /
# capture-exec / fetch-plugin / config) as subcommands of this binary, and refuse to run without it
# (`${BUSBAR_ORACLE_BIN:?}`) rather than degrade into a named gap. The native recorder sets this too,
# for callers that drive it without going through this shim.
export BUSBAR_ORACLE_BIN="$JUDGE_ENTRY"

# ── argv contract (unchanged for callers) → the Rust CLI ────────────────────────────────────────
# The callers (the `.ci/` branch files, the scripts, HarnessOracle's record.sh shim) speak the
# historical Python argv. The Rust CLI takes explicit paths; this dispatcher fills the same
# BUSBAR_ORACLE_DATA-derived defaults the Python tool derived, so `./bin/oracle <sub> …` is unchanged.
DATA="$BUSBAR_ORACLE_DATA"
ROOT="$BUSBAR_ORACLE_PRODUCT_ROOT"
CACHE="${BUSBAR_ORACLE_CACHE:-$cache_home/busbar-oracle}"
sub="${1:-}"; shift || true

case "$sub" in
  tool-dir)
    echo "$BUSBAR_ORACLE_TOOL_DIR"; exit 0 ;;

  cells)
    # `cells --check` / `--selftest` — default --cells from the data dir (Python read $DATA).
    has_cells=0; for a in "$@"; do [ "$a" = "--cells" ] && has_cells=1; done
    if [ "$has_cells" -eq 0 ]; then set -- "$@" --cells "$DATA/cells.json"; fi
    verify_judge_now; exec "$RUST_BIN" cells "$@" ;;

  replay-selftest)
    # the owed-baseline ratchet over the committed golden (Python read $DATA).
    # Under ModernCI the golden is the config's tree from the object database, never the worktree.
    args=(--golden "$DATA/golden/1.5.5" --baseline "$DATA/owed-baseline.txt" "$@")
    if under_modernci; then modernci_golden || exit 3; fi
    verify_judge_now; exec "$RUST_BIN" replay-selftest "${args[@]}" ;;

  fetch-golden)
    # WORKAROUND for a parser bug in the pinned Rust engine (busbar-release @ the branch file's BUSBAR_ORACLE_RELEASE_REF): its
    # fetch-golden `pinned()` reader does `let (v,a,d)=(f.next()?,f.next()?,f.next()?)` per line, so the
    # FIRST tab-less comment line in golden-digests.tsv (`# Pinned from …`) makes the `?` return None
    # from the whole function — it never reaches the data rows and exits 3 ("no pinned digest"). The
    # sibling `pinned_binary_digests()`/`find_pin()` correctly `continue` on short rows, so only
    # fetch-golden is affected (replay's --check-golden gate is fine). Feed the engine a de-commented
    # copy (identical data rows, tabs preserved) until the parser is fixed upstream and re-pinned.
    clean="$root/golden-digests.clean.tsv"
    grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$DATA/golden-digests.tsv" > "$clean"
    verify_judge_now; exec "$RUST_BIN" fetch-golden --digests "$clean" --cache-dir "$CACHE" "$@" ;;

  fetch-plugin)
    # `fetch-plugin <name> [--check]` — the data dir carries plugin-digests.tsv.
    verify_judge_now; exec "$RUST_BIN" fetch-plugin "$1" --data "$DATA" "${@:2}" ;;

  record)
    # OLD: record --bin B --plane P --out O [--filter F]  →  native Rust recorder.
    BIN="" OUT="" PLANE="all" FILTER=""
    while [ $# -gt 0 ]; do case "$1" in
      --bin) BIN="$2"; shift 2;;
      --out) OUT="$2"; shift 2;;
      --plane) PLANE="$2"; shift 2;;
      --filter) FILTER="$2"; shift 2;;
      --shared-state) shift;;
      *) shift;;
    esac; done
    [ -n "$BIN" ] && [ -n "$OUT" ] || { echo "oracle record: need --bin and --out" >&2; exit 2; }
    # A BOUND BAND NAMES ITS HOLDER. The recorder refuses a band something already listens on, but
    # it names only the ports, and the usual holder is a busbar a previous recording leaked. Until
    # that process is found, every later recording on the band is refused or, if it got past the
    # check, answered by the stale node instead of the candidate. So an explicitly chosen band is
    # checked here first, and the refusal names each listener's pid and command line. An unset port
    # is left to the recorder, which picks a free band itself.
    busy=""
    for port in ${ORACLE_LISTEN_PORT:-} ${ORACLE_ADMIN_PORT:-} ${ORACLE_MOCK_PORT:-}; do
      for pid in $(lsof -nP -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | sort -u); do
        busy="${busy}  port $port: pid $pid ($(ps -o command= -p "$pid" 2>/dev/null | cut -c1-160))
"
      done
    done
    if [ -n "$busy" ]; then
      printf 'oracle record: the recording band is already bound, so nothing is recorded:\n%sStop the stale process (kill <pid>) or choose a free ORACLE_LISTEN_PORT/ORACLE_ADMIN_PORT/ORACLE_MOCK_PORT.\n' "$busy" >&2
      exit 2
    fi
    # --out IS HONOURED, BY BEING PASSED. This used to send only --work-dir and let the recorder
    # write <work>/candidate, then PRINT that the --out basename "is honored as that dir". It was
    # not: measured, `--out /tmp/x/money` wrote the recording to /tmp/x/candidate, left /tmp/x/money
    # empty, and exited 0 saying "recorded 1 cell(s)". A caller that then read its own --out found an
    # empty directory and reported "0 cells recorded" — which is how a working recorder reads as a
    # broken one, and is the reported shape of "--filter records nothing". The engine has taken
    # --out-dir for exactly this since the native cutover; this just stops discarding it.
    mkdir -p "$OUT"; OUT="$(cd "$OUT" && pwd)"; WORK="$(cd "$(dirname "$OUT")" && pwd)"
    # A filtered recording carries the premise cells its forgivenesses probe (see premise_closure).
    [ -z "$FILTER" ] || FILTER="$(widen_filter "$FILTER")"
    rc=0; verify_judge_now; private_tmp "$RUST_BIN" record --native --busbar-repo "$ROOT" --candidate-bin "$BIN" \
      --oracle-data "$DATA" --work-dir "$WORK" --out-dir "$OUT" --family "$PLANE" ${FILTER:+--filter "$FILTER"} || rc=$?
    exit "$rc" ;;

  replay)
    # ── THE PREDEV FENCES, IN THEIR OWN SECTION ────────────────────────────────────────────────
    # testing/shadow-oracle/fence/<name>/ holds cells recorded from a named predev build (no 1.5.5
    # baseline exists for them: the mcp/a2a/decisions planes). They are judged AFTER the 1.5.5
    # verdict, each fence against its own recording, under a separate "predev fence" heading —
    # never merged into golden/1.5.5 and never cited as 1.5.5 evidence. A fence DIVERGENCE is red:
    # it is a regression, or a change an ARCHITECT ruling re-records the fence for. The replay's exit
    # is the worse of the two.
    replay_fences() {  # replay_fences <1.5.5 rc> <id filter or ""> <diff args...>
      local rc="$1" idf="$2"; shift 2
      local cand="" out="" a prev=""
      for a in "$@"; do
        case "$prev" in --candidate) cand="$a";; --out) out="$a";; esac; prev="$a"
      done
      [ -d "$DATA/fence" ] || return "$rc"
      local f frc worst="$rc" ids
      for f in "$DATA"/fence/*/; do
        f="${f%/}"; [ -f "$f/ledger.tsv" ] || continue
        ids="$(awk -F'\t' 'NF{print $1}' "$f/ledger.tsv" | python3 -c 'import re,sys; print("^("+"|".join(re.escape(l.strip()) for l in sys.stdin if l.strip())+")$")')"
        if [ -n "$idf" ] && ! awk -F'\t' 'NF{print $1}' "$f/ledger.tsv" | grep -Eq -- "$idf"; then continue; fi
        echo
        echo "== predev fence: $(basename "$f") (recorded from a predev build; NOT 1.5.5 evidence) =="
        set +e
        judge diff --golden "$f" --candidate "$cand" --out "${out:-$(mktemp -d)}/fence-$(basename "$f")" \
          --cells "$DATA/cells.json" --id-filter "$ids" --strict
        frc=$?; set -e
        [ "$frc" -le "$worst" ] || worst="$frc"
      done
      return "$worst"
    }
    # ── THE DATED FAMILY BASELINES, IN THEIR OWN SECTION ──────────────────────────────────────
    # testing/shadow-oracle/family-baselines.tsv names a family whose baseline is NOT 1.5.5 because
    # 1.5.5 never served it, and the dated baseline it is judged against instead (`streams` ->
    # `golden/1.6.0-pre`, recorded from a pinned pre-fold predev build; OWNER RULING 2026-09-30,
    # 1.6.0-QUESTIONS.md STREAMS-ORACLE option A). Against 1.5.5 such a family's cells are UNBASELINED
    # (named, not green, not red); here each is judged against its own baseline by NAME
    # (`--baseline-version`, which refuses a baseline that does not exist), --strict, under its own
    # heading. A divergence is red. The replay's exit is the worst of every section.
    family_baseline_rows() {  # -> "family<TAB>version" per row
      [ -f "$DATA/family-baselines.tsv" ] || return 0
      grep -vE '^[[:space:]]*(#|$)' "$DATA/family-baselines.tsv" || true
    }
    # only_rebaselined <filter> -> 0 when the filter selects at least one cell and every selected
    # cell's family has a dated baseline of its own (so the 1.5.5 section owes nothing to compare).
    only_rebaselined() {
      python3 - "$1" "$DATA/cells.json" "$(family_baseline_rows | cut -f1 | tr '\n' ' ')" <<'PY'
import json, re, sys
sel, fams = re.compile(sys.argv[1]), set(sys.argv[3].split())
cells = [c for c in json.load(open(sys.argv[2]))["cells"] if sel.search(c["id"])]
sys.exit(0 if cells and all(c.get("family", c.get("plane")) in fams for c in cells) else 1)
PY
    }
    replay_family_baselines() {  # replay_family_baselines <rc so far> <id filter or ""> <diff args...>
      local rc="$1" idf="$2"; shift 2
      local cand="" out="" acc="" a prev=""
      for a in "$@"; do
        case "$prev" in --candidate) cand="$a";; --out) out="$a";; --accepted) acc="$a";; esac; prev="$a"
      done
      local fam ver frc worst="$rc"
      while IFS=$'\t' read -r fam ver; do
        [ -n "$fam" ] && [ -n "$ver" ] || continue
        if [ -n "$idf" ] && ! python3 - "$idf" "$DATA/cells.json" "$fam" <<'PY'
import json, re, sys
sel = re.compile(sys.argv[1])
sys.exit(0 if any(sel.search(c["id"]) and c.get("family") == sys.argv[3]
                  for c in json.load(open(sys.argv[2]))["cells"]) else 1)
PY
        then continue; fi
        echo
        echo "== dated baseline: family $fam against golden/$ver (NOT 1.5.5 evidence) =="
        frc=0
        judge diff --baseline-version "$ver" --candidate "$cand" \
          --out "${out:-$(mktemp -d)}/baseline-$ver-$fam" --cells "$DATA/cells.json" \
          ${acc:+--accepted "$acc"} --family "^$(printf '%s' "$fam" | sed 's/[.]/\\./g')\$" \
          ${idf:+--id-filter "$idf"} --strict || frc=$?
        [ "$frc" -le "$worst" ] || worst="$frc"
      done < <(family_baseline_rows)
      return "$worst"
    }
    # A REPLAY THAT JUDGED NOTHING IS NOT A VERDICT (2026-10-07, ORACLE-BURN: a filtered replay
    # handed `--filter`, which is record's flag, exited 2 from the engine's argument parser; the
    # fence and dated-baseline sections then ran and printed their own rows, which read like a
    # verdict over the selected cells). The 1.5.5 section answers first and alone: an argument
    # refusal (2) stops the replay there, and a report that compared no owed cell is a refusal (3).
    judged_or_refuse() {  # judged_or_refuse <1.5.5 rc> <diff args...>
      local rc="$1" out="" a prev=""; shift
      if [ "$rc" -ge 2 ]; then
        echo "oracle: the 1.5.5 replay refused (exit $rc, above); nothing was judged, so no other section runs." >&2
        exit "$rc"
      fi
      for a in "$@"; do [ "$prev" = --out ] && out="$a"; prev="$a"; done
      [ -n "$out" ] || return 0
      python3 -c '
import json, sys
try:
    owed = json.load(open(sys.argv[1]))["totals"]["owed"]
except Exception as e:
    sys.exit("oracle: the 1.5.5 replay wrote no readable report (%s: %s); nothing was judged. Refusing." % (sys.argv[1], e))
if not owed:
    sys.exit("oracle: the 1.5.5 replay compared ZERO owed cells (%s); a replay that judged nothing is not a verdict. Refusing." % sys.argv[1])
' "$out/report.json" || exit 3
    }
    # OLD: replay --golden G --candidate C --out R  →  the in-process Rust differ (the judge).
    #
    # NO HARNESS-REVISION FLAG EXISTS ANY MORE (ORACLE-STABLE). The differ judges cell by cell; the
    # whole-tree harness_rev refusal and `--allow-harness-skew` are gone from the engine. The 1.5.5
    # golden is immutable and add-only (the promote hop's golden-guard), and the engine's own CI
    # replays the published 1.5.5 binary over it, twice, byte-for-byte.
    # A FILTERED REPLAY: widen --id-filter to the premise cells, and refuse (by name) any selected
    # forgiveness the engine still withholds for an unevaluable premise.
    IDF="" args=()
    while [ $# -gt 0 ]; do case "$1" in
      --id-filter) IDF="$2"; shift 2;;
      --filter|--filter=*) refuse_filter_flag replay ;;
      *) args+=("$1"); shift;;
    esac; done
    # UNDER MODERNCI THE 1.5.5 GOLDEN IS THE CONFIG'S TREE, READ FROM THE OBJECT DATABASE. Every
    # `--golden` is replaced by BUSBAR_GOLDEN_1_5_5_TREE extracted from git (odb_golden), never a
    # worktree path, and the candidate's golden/1.5.5 tree must equal it. A golden held add-only to a
    # commit of the candidate's own history graded the candidate: a target can hold none (qa at
    # 1.5.5), and a parent can be the candidate's own first commit.
    if under_modernci; then
      have=0; for a in "${args[@]}"; do case "$a" in --golden|--golden=*) have=1;; esac; done
      [ "$have" = 1 ] || { echo "oracle: a replay under ModernCI names its 1.5.5 golden with --golden; none was given. Refusing." >&2; exit 3; }
      modernci_golden || exit 3
    fi
    if [ -z "$IDF" ]; then
      set +e; judge diff "${args[@]}" --cells "$DATA/cells.json"; rc=$?; set -e
      judged_or_refuse "$rc" "${args[@]}"
      frc=0; replay_fences "$rc" "" "${args[@]}" || frc=$?
      brc=0; replay_family_baselines "$frc" "" "${args[@]}" || brc=$?
      exit "$brc" ; fi
    # A filter that selects ONLY families with a dated baseline of their own owes the 1.5.5 section
    # nothing: its --strict would refuse "no owed cells matched", a red that judges nothing.
    if only_rebaselined "$IDF"; then
      echo "oracle: the filter selects only families with a dated baseline (family-baselines.tsv); the 1.5.5 section is skipped" >&2
      brc=0; replay_family_baselines 0 "$IDF" "${args[@]}" || brc=$?; exit "$brc"
    fi
    WIDE="$(widen_filter "$IDF")"
    log="$(mktemp)"; verify_judge_now; set +e
    "$RUST_BIN" diff "${args[@]}" --id-filter "$WIDE" --cells "$DATA/cells.json" 2>&1 | tee "$log"
    rc=${PIPESTATUS[0]}; set -e
    judged_or_refuse "$rc" "${args[@]}"
    withheld_selected "$log" "$IDF" || { rm -f "$log"; exit 3; }
    rm -f "$log"; frc=0; replay_fences "$rc" "$IDF" "${args[@]}" || frc=$?
    brc=0; replay_family_baselines "$frc" "$IDF" "${args[@]}" || brc=$?; exit "$brc" ;;

  diff)
    # The engine's own diff: a FILTERED one gets the same premise widening and refusal as replay.
    IDF="" args=()
    while [ $# -gt 0 ]; do case "$1" in
      --id-filter) IDF="$2"; shift 2;;
      --filter|--filter=*) refuse_filter_flag diff ;;
      *) args+=("$1"); shift;;
    esac; done
    # Under ModernCI a diff's --golden is the 1.5.5 golden: the config's tree from the object database.
    if under_modernci; then modernci_golden || exit 3; fi
    if [ -z "$IDF" ]; then verify_judge_now; exec "$RUST_BIN" diff "${args[@]}"; fi
    WIDE="$(widen_filter "$IDF")"
    log="$(mktemp)"; verify_judge_now; set +e
    "$RUST_BIN" diff "${args[@]}" --id-filter "$WIDE" 2>&1 | tee "$log"
    rc=${PIPESTATUS[0]}; set -e
    withheld_selected "$log" "$IDF" || { rm -f "$log"; exit 3; }
    rm -f "$log"; exit "$rc" ;;

  *)
    # normalize / merge / renormalize / harness-rev / selftest / … pass through unchanged.
    verify_judge_now; exec "$RUST_BIN" "$sub" "$@" ;;
esac
