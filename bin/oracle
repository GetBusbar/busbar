#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2026 Busbar Inc and contributors
#
# Launcher only (BLD-6: shell launchers stay at 20 lines or fewer, build and CI tooling is Rust). Builds
# tools/ci-checks and runs `busbar-ci-checks oracle run "$@"` from the caller's directory: it fetches the
# pinned `busbar-oracle` judge, holds it to its sha256, and speaks the argv this file always spoke (cells,
# record, replay, diff, ci-run, shard-*, fetch-*, the selftests, ...). BUSBAR_CI_CHECKS_ROOT names the
# checkout to build in (the selftests drive scratch copies of this launcher that have no tools/ of their own).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
root="${BUSBAR_CI_CHECKS_ROOT:-$here}"
exe="$(cd "$root" && cargo build --locked --quiet -p busbar-ci-checks --bin busbar-ci-checks \
  --message-format=json-render-diagnostics </dev/null | sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -1)" || exe=""
[ -n "$exe" ] && [ -x "$exe" ] || { echo "oracle: busbar-ci-checks (tools/ci-checks) did not build in $root" >&2; exit 3; }
BUSBAR_ORACLE_HOME="$here" exec "$exe" oracle run "$@"
