#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2026 Busbar Inc and contributors
#
# The shadow oracle is a separate product now (GetBusbar/busbar-oracle). This is the ONE piece of
# glue busbar keeps: it installs the PINNED tool into target/oracle/tool and runs it against this
# checkout's data. The pin (tag + sha256 of the release archive) is testing/shadow-oracle/oracle.pin;
# a tool whose archive does not hash to the pin is refused, because an unpinned judge is not a judge.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pin="$here/testing/shadow-oracle/oracle.pin"
tag="$(awk -F= '$1=="tag"{print $2}' "$pin")"; sha="$(awk -F= '$1=="sha256"{print $2}' "$pin")"
root="$here/target/oracle/tool/$tag"
if [ ! -x "$root/bin/busbar-oracle" ]; then
  mkdir -p "$root"; tgz="$here/target/oracle/$tag.tar.gz"
  curl -fsSL -o "$tgz" "https://github.com/GetBusbar/busbar-oracle/archive/refs/tags/$tag.tar.gz"
  got="$( (command -v sha256sum >/dev/null && sha256sum "$tgz" || shasum -a 256 "$tgz") | cut -d' ' -f1)"
  [ "$got" = "$sha" ] || { echo "oracle: $tag archive is $got, pinned $sha" >&2; exit 1; }
  tar -xzf "$tgz" -C "$root" --strip-components=1
  # --no-cache-dir IS THE PIN. Without it pip happily reuses a wheel it built earlier for the same
  # name+version, so a digest-verified download can be silently shadowed by whatever "busbar-oracle
  # 0.1.0" happened to be on this machine first — which is exactly the substitution the pin exists
  # to prevent. Observed, not theoretical: it served a stale judge on the first run of this shim.
  python3 -m venv "$root/.venv" && "$root/.venv/bin/pip" -q install --no-cache-dir "$root" && ln -sfn "$root/.venv/bin" "$root/bin"
fi
# The pin IS the harness's tool half: harness-rev hashes this digest instead of the tool's files.
export BUSBAR_ORACLE_TOOL_DIGEST="$tag@$sha"
# Defaults, not overrides. The tool's own self-tests prove the harness revision MOVES when a file
# that decides a verdict changes, which they do by editing a throwaway copy of the data and re-asking
# — impossible if this shim forced every run at busbar's real directory.
export BUSBAR_ORACLE_PRODUCT_ROOT="${BUSBAR_ORACLE_PRODUCT_ROOT:-$here}"
# The tool must not litter the DATA directory with byte-code caches: the segregation gate walks
# that directory and refuses a file it cannot read as source, and a cache is not a data file.
export PYTHONDONTWRITEBYTECODE=1
export BUSBAR_ORACLE_DATA="${BUSBAR_ORACLE_DATA:-$here/testing/shadow-oracle}"
# The cell DRIVERS under the data directory call the tool's fetchers (fetch-plugin.sh, fetch-golden.sh),
# which left this tree with the tool. They find them through this variable, never by a path beside
# themselves, so a driver cannot silently fall back to a stale in-tree copy.
export BUSBAR_ORACLE_TOOL_DIR="${BUSBAR_ORACLE_TOOL_DIR:-$("$root/.venv/bin/python" -c 'import busbar_oracle, os; print(os.path.dirname(busbar_oracle.__file__))')}"
# `tool-dir` is BUSBAR'S OWN word, handled here and never passed through: it installs the pin if it
# is not installed yet (the block above) and prints where the tool landed. It exists so a caller that
# needs ONE tool FILE rather than a tool COMMAND -- the llm-conformance gate reaches for the tool's
# build-request.py when a recording lacks raw request bytes -- can find it through the same pin every
# other caller is judged by, instead of guessing a path beside busbar's data directory.
if [ "${1:-}" = tool-dir ]; then echo "$BUSBAR_ORACLE_TOOL_DIR"; exit 0; fi
exec "$root/bin/busbar-oracle" "$@"
