#!/bin/sh
# Test double for the GitHub CLI release subcommands, over the world's state/releases.
here=$(cd "$(dirname "$0")" && pwd)
state="$here/../state"
if [ "$1" = api ] && [ -f "$state/full_names.json" ]; then
  # `gh api repos/<org>/<name> -q .full_name`: the repo GitHub redirects that name to. A world
  # without full_names.json has no GitHub API at all (the lookup cannot run).
  name=${2#repos/}
  full=$(sed -n "s|.*\"$name\": *\"\([^\"]*\)\".*|\1|p" "$state/full_names.json" 2>/dev/null)
  [ -n "$full" ] && { echo "$full"; exit 0; }
  echo "gh: Not Found (HTTP 404)" >&2
  exit 1
fi
[ "$1" = release ] || exit 2
action=$2
tag=$3
shift 3
repo=""
dl=""
list="$state/.gh-files.$$"
: > "$list"
while [ $# -gt 0 ]; do
  case "$1" in
    -R) repo=$2; shift 2 ;;
    -D) dl=$2; shift 2 ;;
    --title|--target|--notes-file) shift 2 ;;
    --*) shift ;;
    *) printf '%s\n' "$1" >> "$list"; shift ;;
  esac
done
d="$state/releases/$repo/$tag"
case "$action" in
  create) mkdir -p "$d"; cat > /dev/null ;;
  upload) mkdir -p "$d"; while IFS= read -r f; do cp "$f" "$d/"; done < "$list" ;;
  edit) touch "$d/.published" ;;
  download)
    missing=$(cat "$state/missing" 2>/dev/null)
    for f in "$d"/*; do
      name=$(basename "$f")
      [ "$name" = "$missing" ] && continue
      if [ -f "$state/replace/$name" ]; then cp "$state/replace/$name" "$dl/$name"; else cp "$f" "$dl/$name"; fi
    done ;;
  *) rm -f "$list"; exit 2 ;;
esac
rm -f "$list"
