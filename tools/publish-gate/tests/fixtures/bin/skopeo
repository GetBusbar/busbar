#!/bin/sh
# Test double for skopeo copy: a tag copy records the digest under the world's state/registry.
here=$(cd "$(dirname "$0")" && pwd)
state="$here/../state"
[ "$1" = copy ] || exit 2
src=$4
dest=$5
case "$src" in oci-archive:*) [ -f "${src#oci-archive:}" ] || exit 1 ;; esac
echo "$src -> $dest" >> "$state/skopeo.log"
case "$dest" in
  docker://*@*) ;;
  docker://*)
    ref=${dest#docker://}
    mkdir -p "$state/registry"
    printf '%s' "${src##*@}" > "$state/registry/$(printf '%s' "$ref" | tr '/:' '__')" ;;
esac
